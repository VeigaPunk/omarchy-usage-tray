# (`credits` + per-snapshot `credits_*`), so a v1 record must be re-probed.
VERSION = 2
# User-facing release. Adding a provider record (OpenCode Go, Charm Hyper)
# leaves existing cache rows valid, so the schema stays put and only this
# number moves.
