#!/usr/bin/env python3
"""Cache AI CLI usage windows and render a Waybar chip. waybar reads cache only."""

from __future__ import annotations

import argparse
import base64
import json
import math
import os
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import UTC, datetime
from pathlib import Path

# Cache schema. 2 replaced the v1 `capacity` block with credit totals
# (`credits` + per-snapshot `credits_*`), so a v1 record must be re-probed.
VERSION = 2
# User-facing release.
TOOL_VERSION = "1.14.0"
METER_WIDTH = 6
TOOLTIP_METER_WIDTH = 10
METER_FILL = "#f2f2f2"
METER_TRACK = "#3a3a3a"
NBSP = "\u00a0"
TUI_METER_WIDTH = 20
STALE_AFTER_SEC = 20 * 60

PROVIDERS = (
    ("codex", "Codex", "C"),
    ("grok", "Grok", "G"),
    ("kimi", "Kimi", "K"),
    ("cursor", "Cursor", "R"),
    ("devin", "Devin", "D"),
    ("devin2", "Devin 2", "d"),
    ("opencode-go", "OpenCode Go", "O"),
    ("zai", "Z.ai", "Z"),
    ("minimax", "MiniMax", "M"),
    ("google", "Google", "g"),
    ("anthropic", "Anthropic", "A"),
    ("commandcode", "Command Code", "⌘"),
    ("inception", "Inception", "I"),
    ("mistral", "Mistral", "ⓜ"),
    ("amr", "OpenDesign", "◇"),
)
PROVIDER_INDEX = {pid: (name, logo) for pid, name, logo in PROVIDERS}


def ensure_path() -> None:
    extra = [
        str(Path.home() / ".local/bin"),
        "/usr/local/bin",
        "/usr/bin",
    ]
    cur = os.environ.get("PATH", "")
    os.environ["PATH"] = ":".join(dict.fromkeys(extra + cur.split(":")))


def cache_path() -> Path:
    return Path(os.environ.get("AI_USAGE_CACHE", Path.home() / ".cache/ai-usage/status.json"))


def selected_path() -> Path:
    return Path(os.environ.get("AI_USAGE_SELECTED", Path.home() / ".config/ai-usage/selected"))


def providers_path() -> Path:
    return Path(os.environ.get("AI_USAGE_PROVIDERS_FILE", Path.home() / ".config/ai-usage/providers"))


def _roster_ids(text: str) -> list[str]:
    """Provider ids out of one roster source, in order and deduplicated."""
    return list(dict.fromkeys(tok for tok in re.split(r"[,\s]+", text.strip()) if tok))


def _roster_from_env() -> list[str]:
    """AI_USAGE_PROVIDERS: comma and/or whitespace separated ids."""
    return _roster_ids(os.environ.get("AI_USAGE_PROVIDERS") or "")


def _roster_from_file() -> list[str]:
    """One provider id per line; `#` comments and blank lines are skipped."""
    try:
        text = providers_path().read_text(encoding="utf-8")
    except OSError:
        return []
    ids: list[str] = []
    for line in text.splitlines():
        ids.extend(_roster_ids(line.split("#", 1)[0]))
    return list(dict.fromkeys(ids))


# Ids already reported as unknown, so one run warns once per bad id: the roster
# is re-read by every command that iterates providers.
_ROSTER_WARNED: set[str] = set()


def active_providers() -> list[tuple]:
    """PROVIDERS scoped to the opt-in roster, or all of them when none is set.

    The env roster wins over ~/.config/ai-usage/providers so one shell run can
    narrow a single probe without editing the machine's file. An unknown id
    warns and is skipped, and a roster with nothing known in it falls back to
    the full tuple, so a typo can never blank the chip.
    """
    ids = _roster_from_env() or _roster_from_file()
    if not ids:
        return list(PROVIDERS)
    wanted: set[str] = set()
    for pid in ids:
        if pid in PROVIDER_INDEX:
            wanted.add(pid)
        elif pid not in _ROSTER_WARNED:
            _ROSTER_WARNED.add(pid)
            print(f"ai-usage: unknown provider in roster: {pid}", file=sys.stderr)
    if not wanted:
        return list(PROVIDERS)
    # PROVIDERS order, not roster order: the cycle and the chip row stay
    # canonical however the roster happens to be sorted.
    return [row for row in PROVIDERS if row[0] in wanted]


def active_provider_ids() -> list[str]:
    return [pid for pid, _, _ in active_providers()]


def waybar_signal() -> int:
    """Realtime-signal offset custom/ai-usage listens on.

    Waybar measures the module's `signal` from SIGRTMIN, and the installer
    picks that slot, so the CLI reads it back instead of assuming a number.
    """
    fallback = 11
    path = Path(
        os.environ.get("AI_USAGE_WAYBAR_CONFIG", Path.home() / ".config" / "waybar" / "config.jsonc")
    )
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return fallback
    match = re.search(r'"custom/ai-usage"\s*:\s*\{.*?"signal"\s*:\s*(\d+)', text, re.DOTALL)
    if not match:
        return fallback
    try:
        sig = int(match.group(1))
    except ValueError:
        return fallback
    return sig if 11 <= sig < 31 else fallback


def poke_waybar() -> None:
    """Refresh the chip now that the selected provider changed.

    `pkill -RTMIN+N` is not a signal procps-ng accepts (it parses `-R` and
    bails), so SIGRTMIN is resolved here and the pid is signalled directly —
    the offset is what the module actually listens on.
    """
    offset = waybar_signal()
    base = getattr(signal, "SIGRTMIN", None)
    if not isinstance(base, int):
        return
    try:
        listed = subprocess.run(
            ["pgrep", "-x", "waybar"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return
    for token in listed.stdout.split():
        if not token.isdigit():
            continue
        try:
            os.kill(int(token), base + offset)
        except OSError:
            continue


def iso_now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_from_unix(ts) -> str | None:
    if ts is None or ts == "":
        return None
    if isinstance(ts, str) and "T" in ts and not ts.strip().isdigit():
        return ts
    try:
        n = float(ts)
        if n >= 1e12:
            n = n / 1000.0
        return datetime.fromtimestamp(int(n), tz=UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OSError, OverflowError):
        return None


def as_pct(value) -> float | None:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, str) and not value.strip():
        return None
    try:
        pct = float(value)
    except (TypeError, ValueError):
        return None
    if math.isnan(pct) or math.isinf(pct):
        return None
    pct = round(pct, 4)
    return max(0.0, min(100.0, pct))




def ratio(used, limit) -> float | None:
    try:
        u = float(used)
        lim = float(limit)
    except (TypeError, ValueError):
        return None
    if lim <= 0:
        return None
    return as_pct(100.0 * u / lim)


def window(kind: str, label: str, used_pct, resets_at=None, extra=None) -> dict:
    out = {"kind": kind, "label": label}
    pct = as_pct(used_pct)
    if pct is not None:
        # Preserve ints from provider JSON (75 not 75.0) when exact.
        out["used_pct"] = int(pct) if float(pct) == int(pct) else pct
    if resets_at:
        out["resets_at"] = resets_at
    if extra:
        out["extra"] = extra
    return out


def empty_provider(pid: str, status: str, reason: str | None = None, plan: str | None = None) -> dict:
    name, logo = PROVIDER_INDEX[pid]
    rec = {
        "id": pid,
        "name": name,
        "logo": logo,
        "status": status,
        "windows": [
            {"kind": "weekly", "label": "Weekly"},
            {"kind": "special", "label": "Special"},
        ],
    }
    if reason:
        rec["reason"] = reason
    if plan:
        rec["plan"] = plan
    return rec


def redact(text: str) -> str:
    text = re.sub(r"(?i)Bearer\s+\S+", "[redacted]", text)
    text = re.sub(r"eyJ[A-Za-z0-9_\-]+=*\.[A-Za-z0-9_\-\.]+", "[redacted]", text)
    text = re.sub(r"devin-[A-Za-z0-9_\-]{8,}", "[redacted]", text)
    text = re.sub(r"sk-[A-Za-z0-9]{8,}", "[redacted]", text)
    text = re.sub(r"(?i)Bearer\s*", "", text)
    return text


def ensure_dir(path: Path, mode: int = 0o700) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    parent_mode = 0o700 if path.name == "status.json" or path.parent.name == "ai-usage" else 0o755
    ensure_dir(path.parent, parent_mode)
    fd, tmp = tempfile.mkstemp(prefix=".ai-usage-", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_cache() -> dict:
    path = cache_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"version": VERSION, "updated_at": None, "selected": None, "providers": {}}
    if not isinstance(data, dict):
        return {"version": VERSION, "updated_at": None, "selected": None, "providers": {}}
    data.setdefault("version", VERSION)
    data.setdefault("providers", {})
    if not isinstance(data["providers"], dict):
        data["providers"] = {}
    return data


def save_cache(data: dict) -> None:
    data["version"] = VERSION
    data["updated_at"] = iso_now()
    atomic_write(cache_path(), json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def read_selected(cache: dict | None = None) -> str | None:
    path = selected_path()
    try:
        value = path.read_text(encoding="utf-8").strip()
        if value:
            return value
    except OSError:
        pass
    if cache:
        return cache.get("selected")
    return None


def write_selected(pid: str) -> None:
    path = selected_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, pid + "\n", mode=0o644)


def which(name: str) -> str | None:
    for d in os.environ.get("PATH", "").split(":"):
        if not d:
            continue
        cand = Path(d) / name
        if cand.is_file() and os.access(cand, os.X_OK):
            return str(cand)
    return None


def child_env() -> dict:
    env = os.environ.copy()
    for key in (
        "XAI_API_KEY",
        "GROK_API_KEY",
    ):
        env.pop(key, None)
    return env


def _has_meter(rec: dict) -> bool:
    """Is this record worth retaining across a failed probe?

    Percent windows are the common case; a prepaid credit balance or an
    observed spend has no ceiling to meter, so its number is a meter too.
    """
    windows = [w for w in rec.get("windows") or [] if isinstance(w, dict)]
    if any("used_pct" in w for w in windows):
        return True
    if any(
        isinstance(w.get("extra"), dict)
        and (w["extra"].get("remaining_usd") is not None or w["extra"].get("spent_usd") is not None)
        for w in windows
    ):
        return True
    credits = rec.get("credits")
    return isinstance(credits, dict) and credits.get("remaining") is not None


def keep_last_good(old: dict | None, new: dict) -> dict:
    if new.get("status") == "ok":
        return new
    if new.get("reason") == "switched":
        return new
    if not old or old.get("status") != "ok":
        return new
    if not _has_meter(old):
        return new
    kept = dict(old)
    if new.get("reason"):
        kept["last_error"] = new["reason"]
    return kept


def upsert(cache: dict, rec: dict) -> None:
    providers = cache.setdefault("providers", {})
    pid = rec["id"]
    providers[pid] = keep_last_good(providers.get(pid) if isinstance(providers.get(pid), dict) else None, rec)


def pick_selected(cache: dict) -> str:
    current = read_selected(cache)
    providers = cache.get("providers", {})
    # `select` accepts any known provider, so an off-roster choice still wins
    # while its record can show a real number; the roster scopes the fallbacks.
    if current in PROVIDER_INDEX and _provider_usable(providers.get(current)):
        return current
    roster = active_provider_ids()
    usable = [pid for pid in roster if _provider_usable(providers.get(pid))]
    if usable:
        return usable[0]
    present = [pid for pid in roster if pid in providers]
    if present:
        return present[0]
    return "codex"


# --- OMP-metered providers ---------------------------------------------------
# Every usage meter comes from `omp usage --provider ... --json`; the native
# CLIs (codex, grok, cursor-agent, devin) are not required because OMP meters
# those same subscriptions from its auth store. Cursor alone also reads its
# usage summary, signed with OMP's Cursor login, for the Included total that
# `omp usage` drops. PROVIDERS is scoped to
# providers OMP actually answers for, so no auth is ever guessed.

# provider id -> (omp provider, ((limit id, kind, short label, long label, primary), ...))
OMP_FALLBACK_SPECS = {
    "codex": ("openai-codex", (
        ("openai-codex:primary", "weekly", "7d", "7 days", True),
    )),
    "grok": ("xai-oauth", (
        ("xai-oauth:credits:1w", "weekly", "credits", "SuperGrok Weekly Credits", True),
        ("xai-oauth:product:grokbuild:1w", "component", "build", "Grok Build (Weekly)", False),
        ("xai-oauth:product:grokchat:1w", "component", "chat", "GrokChat (Weekly)", False),
    )),
    "cursor": ("cursor", (
        ("cursor:usd:individual-auto", "monthly", "auto", "Auto", True),
        ("cursor:usd:individual-api", "monthly", "api", "API", True),
    )),
    "devin": ("devin", (
        ("devin:quota:weekly", "weekly", "7d", "Weekly Quota", True),
    )),
    # Same OMP provider as devin; probe_devin2 pins the second account row.
    "devin2": ("devin", (
        ("devin:quota:weekly", "weekly", "7d", "Weekly Quota", True),
    )),
    # MiniMax Token Plan: one shared "general" pool per credential, metered on
    # a rolling 5-hour and a 7-day window.
    "minimax": ("minimax-code", (
        ("general:7d", "weekly", "7d", "7 Day", True),
        ("general:5h", "session", "5h", "5 Hour", True),
    )),
}


def _omp_fallback_rec(pid: str, report_index: int | None = None) -> dict | None:
    """Build a provider record from `omp usage`.

    report_index pins one account out of a multi-account provider (devin2);
    None folds every report the provider answered into one record.
    """
    spec = OMP_FALLBACK_SPECS.get(pid)
    if spec is None:
        return None
    omp_provider, limit_specs = spec
    payload, _failure = omp_usage_payload(omp_provider)
    if payload is None:
        return None
    reports = [
        report
        for report in payload.get("reports") or []
        if isinstance(report, dict) and report.get("provider") == omp_provider
    ]
    if report_index is not None:
        if len(reports) <= report_index:
            return None
        reports = [reports[report_index]]
    if not reports:
        return None

    name, logo = PROVIDER_INDEX[pid]
    spec_values: dict[str, list[float]] = {}
    spec_reset: dict[str, str] = {}
    primary_limits: list[tuple[float, str | None]] = []
    rows: list[dict] = []
    timestamps: list[str] = []
    for report in reports:
        fetched = _token_plan_timestamp(report.get("fetchedAt"))
        if fetched:
            timestamps.append(fetched)
        meta = report.get("metadata") if isinstance(report.get("metadata"), dict) else {}
        who = str(meta.get("email") or meta.get("accountId") or "").strip()
        matched: dict[str, tuple[float, str | None]] = {}
        for limit in report.get("limits") or []:
            if not isinstance(limit, dict):
                continue
            entry = next((item for item in limit_specs if item[0] == limit.get("id")), None)
            if entry is None:
                continue
            lid, kind, _short, long, primary = entry
            frac = _opencode_go_fraction((limit.get("amount") or {}).get("usedFraction"))
            if frac is None:
                continue
            win = limit.get("window") if isinstance(limit.get("window"), dict) else {}
            reset = iso_from_unix(win.get("resetsAt"))
            matched[long] = (frac * 100.0, reset)
            spec_values.setdefault(lid, []).append(frac * 100.0)
            if reset and lid not in spec_reset:
                spec_reset[lid] = reset
            if primary:
                primary_limits.append((frac * 100.0, reset))
        for long, (pct, reset) in matched.items():
            row: dict = {"label": long, "used_pct": as_pct(pct)}
            if who:
                row["account"] = who
            if reset:
                row["resets_at"] = reset
            if fetched:
                row["fetched_at"] = fetched
            rows.append(row)

    if not any(spec_values.get(item[0]) for item in limit_specs if item[4]):
        return None
    windows = []
    for lid, kind, _short, long, primary in limit_specs:
        values = spec_values.get(lid)
        if not values or not primary:
            continue
        windows.append(window(kind, long, as_pct(sum(values) / len(values)), spec_reset.get(lid)))
    hottest = hottest_reset = None
    if primary_limits:
        hottest, hottest_reset = max(primary_limits, key=lambda item: item[0])
    windows.append(window("special", "Hottest", as_pct(hottest), hottest_reset))

    def _list_len(key: str) -> int:
        value = payload.get(key)
        return len(value) if isinstance(value, list) else 0

    rec = {
        "id": pid,
        "name": name,
        "logo": logo,
        "status": "ok",
        "windows": windows,
        "account_usage": rows,
        "snapshot": {
            "reports": len(reports),
            "accounts_without_usage": _list_len("accountsWithoutUsage"),
            "disabled_credentials": _list_len("disabledCredentials"),
        },
        "source": "omp",
    }
    if timestamps:
        rec["measured_at"] = min(timestamps)
    return rec


def _provider_usable(rec) -> bool:
    """Authed and metered: the chip only scopes to providers that can show
    a real number — status ok, a numeric window, or a credit balance."""
    if not isinstance(rec, dict):
        return False
    if rec.get("status") == "ok":
        return True
    for w in rec.get("windows") or []:
        if isinstance(w, dict) and w.get("used_pct") is not None:
            return True
    burst = rec.get("burst")
    if isinstance(burst, dict) and burst.get("used_pct") is not None:
        return True
    credits = rec.get("credits")
    return bool(isinstance(credits, dict) and credits.get("remaining") is not None)


# --- Codex -------------------------------------------------------------------


def probe_codex() -> dict:
    return _omp_fallback_rec("codex") or empty_provider("codex", "unauth", "no_omp_usage")


def cursor_oauth_conf() -> Path:
    return Path(
        os.environ.get(
            "AI_USAGE_CURSOR_OAUTH_CONF",
            Path.home() / ".config" / "cursor-oauth",
        )
    )


def cursor_oauth_identities() -> list[dict]:
    path = cursor_oauth_conf() / "slots"
    out: list[dict] = []
    if not path.is_file():
        return out
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("|")
        sid = parts[0].strip()
        if not sid:
            continue
        title = parts[2].strip() if len(parts) > 2 else sid
        ident = parts[3].strip() if len(parts) > 3 else ""
        out.append({"id": sid, "label": sid, "title": title or sid, "ident": ident})
    return out


def cursor_oauth_active_id() -> str | None:
    path = cursor_oauth_conf() / "active"
    if not path.is_file():
        return None
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return value or None


def cursor_oauth_slot_file(sid: str) -> Path:
    return cursor_oauth_conf() / "identities" / sid / "auth.json"


def cursor_parked_identities() -> list[dict]:
    return [s for s in cursor_oauth_identities() if cursor_oauth_slot_file(s["id"]).is_file()]


def attach_cursor_identity(rec: dict) -> dict:
    parked = cursor_parked_identities()
    if not parked:
        return rec
    rec = dict(rec)
    active = cursor_oauth_active_id() or parked[0]["id"]
    match = next((s for s in parked if s["id"] == active), parked[0])
    rec["identity"] = {
        "id": match["id"],
        "label": match["id"],
        "title": match.get("title") or match["id"],
    }
    rec["identities"] = [{"id": s["id"], "label": s["id"]} for s in parked]
    return rec


# Positive-integer override for pool sizes (Inception's per-key grant).
def _token_plan_pool(env_name: str, default: int) -> int:
    raw = os.environ.get(env_name)
    if raw:
        try:
            value = int(float(raw))
        except (TypeError, ValueError):
            value = 0
        if value > 0:
            return value
    return default


def _credits_label(value) -> str:
    """Compact credit readout: 539999 -> 540k, 23912 -> 24k, 6632.16 -> 6.6k, 950 -> 950."""
    number = _token_plan_number(value)
    if number is None:
        return "—"
    amount = float(number)
    if amount >= 10000:
        return f"{round_half_up(amount / 1000)}k"
    if amount >= 1000:
        return f"{amount / 1000:.1f}".rstrip("0").rstrip(".") + "k"
    return f"{amount:.0f}"


def _token_plan_number(value) -> int | float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    if math.isnan(number) or math.isinf(number) or number < 0:
        return None
    return int(number) if number.is_integer() else number


def _token_plan_timestamp(value) -> str | None:
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, str):
        value = value.strip()
        if not value or "T" not in value:
            return None
    elif not isinstance(value, (int, float)):
        return None
    stamp = parse_reset(value)
    if stamp is None:
        return None
    return stamp.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def omp_usage_payload(provider: str) -> tuple[dict | None, str | None]:
    """`omp usage --provider <provider> --json`, or (None, bounded reason).

    Every OMP-metered provider reads the same report shape, so the invocation,
    timeout, and error vocabulary live here: no_cli, timeout, exit_<code>,
    no_json, bad_payload. Reasons stay short and secret-free because they land
    in the cache and the chip tooltip.
    """
    omp = os.environ.get("AI_USAGE_OMP_BIN") or which("omp")
    if not omp:
        return None, "no_cli"
    try:
        proc = subprocess.run(
            [omp, "usage", "--provider", provider, "--json"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
            env=child_env(),
        )
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except OSError:
        return None, "no_cli"
    if proc.returncode:
        return None, f"exit_{proc.returncode}"
    try:
        payload = json.loads(proc.stdout) if proc.stdout and proc.stdout.strip() else None
    except json.JSONDecodeError:
        return None, "no_json"
    if not isinstance(payload, dict) or not isinstance(payload.get("reports"), list):
        return None, "bad_payload"
    return payload, None


def _omp_declared_accounts(payload: dict, provider: str, window_id: str | None = None) -> int | None:
    """OMP's own account count for the provider.

    Used only to detect under-reporting: a report count below the declared
    account count means the snapshot is incomplete. `window_id` narrows the
    lookup for providers whose capacity block lists several windows.
    """
    capacity_root = payload.get("capacity")
    if not isinstance(capacity_root, dict):
        return None
    rows = capacity_root.get(provider)
    if not isinstance(rows, list):
        return None
    for row in rows:
        if not isinstance(row, dict):
            continue
        if window_id is not None and row.get("window") != window_id:
            continue
        accounts = _token_plan_number(row.get("accounts"))
        if accounts is not None and float(accounts) == int(accounts) and accounts > 0:
            return int(accounts)
    return None


def _omp_window_average(rows: list[dict], kind: str) -> tuple[float | None, int, str | None]:
    """Mean utilization of one window across the accounts that reported it."""
    entries = [
        row["windows"][kind]
        for row in rows
        if isinstance(row.get("windows"), dict) and kind in row["windows"]
    ]
    pcts = [entry.get("used_pct") for entry in entries if entry.get("used_pct") is not None]
    if not pcts:
        return None, 0, None
    resets = sorted(entry["resets_at"] for entry in entries if entry.get("resets_at"))
    return as_pct(sum(pcts) / len(pcts)), len(pcts), (resets[0] if resets else None)


# --- OpenCode Go -------------------------------------------------------------

# OMP window id -> (kind, short label, long label). Monthly anchors on the
# subscription anniversary instead of a rolling 30 days, so a key can sit at
# its monthly cap while the weekly window still reads empty; the chip's special
# slot tracks whichever window is hottest so that key never hides behind an
# averaged bar.
OPENCODE_GO_WINDOWS = (
    ("rolling-5h", "session", "5h", "5 Hour limit"),
    ("weekly", "weekly", "7d", "Weekly limit"),
    ("monthly", "monthly", "monthly", "Monthly limit"),
)
OPENCODE_GO_KINDS = {wid: (kind, short, label) for wid, kind, short, label in OPENCODE_GO_WINDOWS}


def _opencode_go_fraction(value) -> float | None:
    """OMP reports `usedFraction` in 0..1; a percent-shaped payload is tolerated."""
    if isinstance(value, bool) or value is None:
        return None
    try:
        frac = float(value)
    except (TypeError, ValueError):
        return None
    if math.isnan(frac) or math.isinf(frac):
        return None
    if frac > 1:
        frac = frac / 100.0
    return max(0.0, min(1.0, frac))


def _opencode_go_report(report: dict) -> dict:
    """One credential snapshot, in percent.

    OMP exposes no stable account identity here, so a row carries only what was
    measured: the binding window (closest to its cap), every window the server
    answered, the fetch stamp, and the binding reset. Windows the server left
    out are omitted rather than zeroed — an unread window is not an unused one.
    """
    row: dict = {}
    fetched_at = _token_plan_timestamp(report.get("fetchedAt"))
    if fetched_at:
        row["fetched_at"] = fetched_at
    found: dict[str, tuple[float, str | None]] = {}
    limits = report.get("limits")
    for limit in limits if isinstance(limits, list) else []:
        if not isinstance(limit, dict):
            continue
        if limit.get("id") not in OPENCODE_GO_KINDS:
            continue
        amount = limit.get("amount") if isinstance(limit.get("amount"), dict) else {}
        frac = _opencode_go_fraction(amount.get("usedFraction"))
        if frac is None:
            continue
        win = limit.get("window") if isinstance(limit.get("window"), dict) else {}
        found[str(limit["id"])] = (frac, iso_from_unix(win.get("resetsAt") or limit.get("resetsAt")))
    measured: dict[str, dict] = {}
    for wid, kind, short, label in OPENCODE_GO_WINDOWS:
        if wid not in found:
            continue
        frac, resets_at = found[wid]
        entry: dict = {"label": short, "kind_label": label, "used_pct": as_pct(frac * 100.0)}
        if resets_at:
            entry["resets_at"] = resets_at
        measured[kind] = entry
    if not measured:
        return row
    binding = max(measured.items(), key=lambda item: item[1].get("used_pct") or 0.0)[1]
    row["windows"] = measured
    row["label"] = binding["kind_label"]
    row["used_pct"] = binding["used_pct"]
    if binding.get("resets_at"):
        row["resets_at"] = binding["resets_at"]
    return row


def _empty_opencode_go(reason: str) -> dict:
    rec = empty_provider("opencode-go", "unknown", reason)
    rec["windows"] = [
        window("weekly", "Weekly", None),
        window("session", "5 Hour", None),
        window("monthly", "Monthly", None),
        window("special", "Hottest account", None),
    ]
    rec["account_usage"] = []
    rec["snapshot"] = {"reports": 0, "accounts_without_usage": 0, "disabled_credentials": 0}
    return rec


def probe_opencode_go() -> dict:
    payload, failure = omp_usage_payload("opencode-go")
    if payload is None:
        return _empty_opencode_go(failure or "bad_payload")

    raw_reports = payload["reports"]
    reports = [
        report
        for report in raw_reports
        if isinstance(report, dict) and report.get("provider") == "opencode-go"
    ]
    rows = [_opencode_go_report(report) for report in reports]
    accounts_without_usage = payload.get("accountsWithoutUsage")
    disabled_credentials = payload.get("disabledCredentials")
    lists_valid = isinstance(accounts_without_usage, list) and isinstance(disabled_credentials, list)
    missing_count = len(accounts_without_usage) if isinstance(accounts_without_usage, list) else 0
    disabled_count = len(disabled_credentials) if isinstance(disabled_credentials, list) else 0

    weekly, weekly_accounts, weekly_reset = _omp_window_average(rows, "weekly")
    session, session_accounts, session_reset = _omp_window_average(rows, "session")
    monthly, monthly_accounts, monthly_reset = _omp_window_average(rows, "monthly")

    row_pcts = [row.get("used_pct") for row in rows]
    complete_reports = (
        bool(rows)
        and len(raw_reports) == len(rows)
        and isinstance(accounts_without_usage, list)
        and missing_count == 0
        and all(pct is not None for pct in row_pcts)
        and all(isinstance(row.get("fetched_at"), str) for row in rows)
    )
    declared_accounts = _omp_declared_accounts(payload, "opencode-go")
    under_reported = declared_accounts is not None and len(rows) != declared_accounts
    complete_coverage = complete_reports and not under_reported
    hottest = max(row_pcts) if complete_coverage and row_pcts else None
    hottest_reset = None
    if hottest is not None:
        hottest_reset = next(
            (row.get("resets_at") for row in rows if row.get("used_pct") == hottest and row.get("resets_at")),
            None,
        )
    status = "ok" if weekly is not None else "unknown"
    windows = [
        window(
            "weekly",
            f"{weekly_accounts}-account weekly" if weekly_accounts else "Weekly",
            weekly,
            weekly_reset,
        ),
        window(
            "session",
            f"{session_accounts}-account 5 Hour" if session_accounts else "5 Hour",
            session,
            session_reset,
        ),
        window(
            "monthly",
            f"{monthly_accounts}-account monthly" if monthly_accounts else "Monthly",
            monthly,
            monthly_reset,
        ),
        window("special", "Hottest account", hottest, hottest_reset),
    ]
    rec = {
        "id": "opencode-go",
        "name": "OpenCode Go",
        "logo": "O",
        "status": status,
        "windows": windows,
        "account_usage": rows,
        "snapshot": {
            "reports": len(rows),
            "accounts_without_usage": missing_count,
            "disabled_credentials": disabled_count,
        },
    }
    timestamps = [row.get("fetched_at") for row in rows]
    if complete_reports and all(isinstance(stamp, str) for stamp in timestamps):
        rec["measured_at"] = min(timestamps)
    if status != "ok":
        rec["reason"] = "no_used_pct"
    elif not complete_coverage or disabled_count > 0 or not lists_valid:
        rec["reason"] = "partial_usage"
    return rec


# --- Z.ai ---------------------------------------------------------------------

# Z.ai coding plan: OMP meters two credit pools per credential — a rolling 5
# hour quota and the weekly quota — each answered as usedFraction plus an
# absolute credit amount. Only the fraction is kept: the two pools are separate
# ceilings, so a single credit counter on the chip would be ambiguous.
ZAI_WINDOWS = (
    ("zai:credits:5h", "session", "5h", "5 Hour limit"),
    ("zai:credits:1w", "weekly", "7d", "Weekly limit"),
