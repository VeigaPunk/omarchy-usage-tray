def ensure_path() -> None:
    extra = [
        str(Path.home() / ".local/bin"),
        str(Path.home() / ".grok/bin"),
        str(Path.home() / ".local/share/mise/shims"),
        str(Path.home() / ".local/share/mise/installs/node/latest/bin"),
        "/usr/local/bin",
        "/usr/bin",
    ]
    cur = os.environ.get("PATH", "")
    os.environ["PATH"] = ":".join(dict.fromkeys(extra + cur.split(":")))


def cache_path() -> Path:
    return Path(os.environ.get("AI_USAGE_CACHE", Path.home() / ".cache/ai-usage/status.json"))


def selected_path() -> Path:
    return Path(os.environ.get("AI_USAGE_SELECTED", Path.home() / ".config/ai-usage/selected"))


def repo_root() -> Path:
    return Path(__file__).resolve().parent.parent


def prices_path() -> Path:
    return Path(os.environ.get("AI_USAGE_PRICES", repo_root() / "prices.toml"))


def quattro_state_dir() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy" / "agents" / "usage"


def poke_waybar() -> None:
    subprocess.run(
        ["pkill", "-x", "-RTMIN+11", "waybar"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def iso_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_from_unix(ts) -> str | None:
    if ts is None or ts == "":
        return None
    if isinstance(ts, str) and "T" in ts and not ts.strip().isdigit():
        return ts
    try:
        n = float(ts)
        if n >= 1e12:
            n = n / 1000.0
        return datetime.fromtimestamp(int(n), tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OSError, OverflowError):
        return None


def as_pct(value) -> float | None:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, str) and not value.strip():
        return None
    try:
        pct = float(value)
    except (TypeError, ValueError):
        return None
    if pct != pct or pct in (float("inf"), float("-inf")):
        return None
    pct = round(pct, 4)
    return max(0.0, min(100.0, pct))




def ratio(used, limit) -> float | None:
    try:
        u = float(used)
        lim = float(limit)
    except (TypeError, ValueError):
        return None
    if lim <= 0:
        return None
    return as_pct(100.0 * u / lim)


def window(kind: str, label: str, used_pct, resets_at=None, extra=None) -> dict:
    out = {"kind": kind, "label": label}
    pct = as_pct(used_pct)
    if pct is not None:
        # Preserve ints from provider JSON (75 not 75.0) when exact.
        out["used_pct"] = int(pct) if float(pct) == int(pct) else pct
    if resets_at:
        out["resets_at"] = resets_at
    if extra:
        out["extra"] = extra
    return out


def empty_provider(pid: str, status: str, reason: str | None = None, plan: str | None = None) -> dict:
    name, logo = PROVIDER_INDEX[pid]
    rec = {
        "id": pid,
        "name": name,
        "logo": logo,
        "status": status,
        "windows": [
            {"kind": "weekly", "label": "Weekly"},
            {"kind": "special", "label": "Special"},
        ],
    }
    if reason:
        rec["reason"] = reason
    if plan:
        rec["plan"] = plan
    return rec


def redact(text: str) -> str:
    text = re.sub(r"(?i)Bearer\s+\S+", "[redacted]", text)
    text = re.sub(r"eyJ[A-Za-z0-9_\-]+=*\.[A-Za-z0-9_\-\.]+", "[redacted]", text)
    text = re.sub(r"sk-[A-Za-z0-9]{8,}", "[redacted]", text)
    text = re.sub(r"(?i)Bearer\s*", "", text)
    return text


def ensure_dir(path: Path, mode: int = 0o700) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    parent_mode = 0o700 if path.name == "status.json" or path.parent.name == "ai-usage" else 0o755
    ensure_dir(path.parent, parent_mode)
    fd, tmp = tempfile.mkstemp(prefix=".ai-usage-", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_cache() -> dict:
    path = cache_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"version": VERSION, "updated_at": None, "selected": None, "providers": {}}
    if not isinstance(data, dict):
        return {"version": VERSION, "updated_at": None, "selected": None, "providers": {}}
    data.setdefault("version", VERSION)
    data.setdefault("providers", {})
    if not isinstance(data["providers"], dict):
        data["providers"] = {}
    return data


def save_cache(data: dict) -> None:
    data["version"] = VERSION
    data["updated_at"] = iso_now()
    atomic_write(cache_path(), json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def read_selected(cache: dict | None = None) -> str | None:
    path = selected_path()
    try:
        value = path.read_text(encoding="utf-8").strip()
        if value:
            return value
    except OSError:
        pass
    if cache:
        return cache.get("selected")
    return None


def write_selected(pid: str) -> None:
    path = selected_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(path, pid + "\n", mode=0o644)


def which(name: str) -> str | None:
    for d in os.environ.get("PATH", "").split(":"):
        if not d:
            continue
        cand = Path(d) / name
        if cand.is_file() and os.access(cand, os.X_OK):
            return str(cand)
    return None


def child_env() -> dict:
    env = os.environ.copy()
    for key in (
        "XAI_API_KEY",
        "GROK_API_KEY",
        "BAILIAN_TOKEN_PLAN_API_KEY",
        "CURSOR_OAUTH_TOKEN",
        "CURSOR_AUTH_FILE",
    ):
        env.pop(key, None)
    return env


def codex_cmd() -> list[str]:
    """First codex binary that actually answers --version on this PATH.

    The legacy `codex` wrapper needs mise+node on PATH (dies in the systemd
    service's minimal env); codex-titanium is a self-contained rust binary.
    """
    for cand in CODEX_CANDIDATES:
        if not which(cand):
            continue
        try:
            probe = subprocess.run(
                [cand, "--version"],
                capture_output=True,
                text=True,
                timeout=8,
                env=child_env(),
                check=False,
            )
            if probe.returncode == 0 and (probe.stdout or "").strip():
                return [cand, *CODEX_ARGS]
        except Exception:
            continue
    return ["codex", *CODEX_ARGS]


def grok_bin() -> str | None:
    explicit = os.environ.get("GROK_BIN")
    if explicit:
        p = Path(explicit)
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    home = Path.home() / ".grok" / "bin" / "grok"
    if home.is_file() and os.access(home, os.X_OK):
        return str(home)
    return which("grok")


def keep_last_good(old: dict | None, new: dict) -> dict:
    if new.get("status") == "ok":
        return new
    if new.get("reason") == "switched":
        return new
    if not old or old.get("status") != "ok":
        return new
    if not any("used_pct" in w for w in old.get("windows") or [] if isinstance(w, dict)):
        return new
    kept = dict(old)
    if new.get("reason"):
        kept["last_error"] = new["reason"]
    return kept


def upsert(cache: dict, rec: dict) -> None:
    providers = cache.setdefault("providers", {})
    pid = rec["id"]
    providers[pid] = keep_last_good(providers.get(pid) if isinstance(providers.get(pid), dict) else None, rec)


def pick_selected(cache: dict) -> str:
    current = read_selected(cache)
    present = [pid for pid, _, _ in PROVIDERS if pid in cache.get("providers", {})]
    if current in present:
        return current
    for pid, rec in cache.get("providers", {}).items():
        if isinstance(rec, dict) and rec.get("status") == "ok":
            return pid
    if present:
        return present[0]
    return "codex"


# --- Codex RPC ---------------------------------------------------------------


def _send(proc: subprocess.Popen, obj: dict) -> None:
    line = json.dumps(obj, separators=(",", ":")) + "\n"
    proc.stdin.write(line.encode("utf-8"))
    proc.stdin.flush()


def _recv_until(proc: subprocess.Popen, pred, deadline: float, buf: bytearray) -> dict:
    while time.time() < deadline:
        if proc.poll() is not None and not buf:
            raise RuntimeError(f"rpc exited {proc.returncode}")
        timeout = max(0.05, min(0.5, deadline - time.time()))
        r, _, _ = select.select([proc.stdout], [], [], timeout)
        if r:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                if proc.poll() is not None:
                    raise RuntimeError(f"rpc exited {proc.returncode}")
                continue
            buf.extend(chunk)
        while True:
            nl = buf.find(b"\n")
            if nl < 0:
                break
            raw = bytes(buf[:nl])
            del buf[: nl + 1]
            raw = raw.strip()
            if not raw:
                continue
            try:
                msg = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if not isinstance(msg, dict):
                continue
            if pred(msg):
                return msg
    raise TimeoutError("rpc timed out")


def _id_match(msg: dict, rid) -> bool:
    return "id" in msg and msg["id"] == rid and ("result" in msg or "error" in msg)


def codex_rate_limits() -> dict:
    """JSON-RPC: initialize → initialized → account/read → account/rateLimits/read."""
    cmd = codex_cmd()
    if not which(cmd[0]):
        raise FileNotFoundError(cmd[0])
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=child_env(),
        start_new_session=True,
    )
    buf = bytearray()
    deadline = time.time() + RPC_TIMEOUT_SEC
    try:
        _send(
            proc,
            {
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {
                        "name": "ai-usage",
                        "title": "Omarchy usage tray",
                        "version": "0.1.0",
                    },
                    "capabilities": {"experimentalApi": True},
                },
            },
        )
        init = _recv_until(proc, lambda m: _id_match(m, 1), deadline, buf)
        if "error" in init:
            raise RuntimeError(redact(str(init["error"])))
        _send(proc, {"method": "initialized"})
        _send(proc, {"id": 2, "method": "account/read", "params": {"refreshToken": False}})
        acct = _recv_until(proc, lambda m: _id_match(m, 2), deadline, buf)
        if "error" in acct:
            raise RuntimeError(redact(str(acct["error"])))
        _send(proc, {"id": 3, "method": "account/rateLimits/read"})
        limits = _recv_until(proc, lambda m: _id_match(m, 3), deadline, buf)
        if "error" in limits:
            raise RuntimeError(redact(str(limits["error"])))
        result = limits.get("result")
        if not isinstance(result, dict):
            raise RuntimeError("rateLimits/read missing result")
        account = (acct.get("result") or {}).get("account") if isinstance(acct.get("result"), dict) else None
        if isinstance(account, dict):
            result = dict(result)
            result["_planType"] = account.get("planType")
            result["_accountType"] = account.get("type")
        return result
    finally:
        try:
            if proc.stdin:
                proc.stdin.close()
        except OSError:
            pass
        try:
            proc.kill()
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            pass


def _pick_spark(by_id: dict) -> tuple[dict | None, dict | None]:
    spark = by_id.get("codex_bengalfox")
    if not isinstance(spark, dict):
        return None, None
    secondary = spark.get("secondary")
    primary = spark.get("primary")
    if isinstance(secondary, dict) and "usedPercent" in secondary:
        return spark, secondary
    if isinstance(primary, dict) and "usedPercent" in primary:
        return spark, primary
    return spark, None


def normalize_codex(raw: dict) -> dict:
    rate = raw.get("rateLimits") if isinstance(raw.get("rateLimits"), dict) else {}
    by_id = raw.get("rateLimitsByLimitId") if isinstance(raw.get("rateLimitsByLimitId"), dict) else {}
    plan = rate.get("planType") or raw.get("_planType") or raw.get("planType")
    primary = rate.get("primary") if isinstance(rate.get("primary"), dict) else None
    rec = {
        "id": "codex",
        "name": "Codex",
        "logo": "C",
        "status": "unknown",
        "windows": [],
    }
    if plan:
        rec["plan"] = str(plan)
    windows = []
    if primary and "usedPercent" in primary:
        windows.append(
            window(
                "weekly",
                "Weekly",
                primary.get("usedPercent"),
                iso_from_unix(primary.get("resetsAt")),
                extra={"window_mins": primary.get("windowDurationMins")},
            )
        )
    spark, special_win = _pick_spark(by_id)
    spark_label = "Spark"
    if isinstance(spark, dict):
        spark_label = spark.get("limitName") or spark_label
        burst = spark.get("primary") if isinstance(spark.get("primary"), dict) else None
        if special_win is burst:
            burst = None
        if burst and "usedPercent" in burst:
            rec["burst"] = window(
                "burst",
                "Spark 5h",
                burst.get("usedPercent"),
                iso_from_unix(burst.get("resetsAt")),
                extra={"window_mins": burst.get("windowDurationMins")},
            )
    if special_win and "usedPercent" in special_win:
        windows.append(
            window(
                "special",
                str(spark_label),
                special_win.get("usedPercent"),
                iso_from_unix(special_win.get("resetsAt")),
                extra={"window_mins": special_win.get("windowDurationMins")},
            )
        )
    else:
        windows.append({"kind": "special", "label": spark_label})
    rec["windows"] = windows
    if any("used_pct" in w for w in windows):
        rec["status"] = "ok"
    else:
        rec["status"] = "unknown"
        rec["reason"] = "no_used_pct"
    return rec


def probe_codex(fixture: str | None = None) -> dict:
    rec: dict
    try:
        if fixture:
            raw = json.loads(Path(fixture).read_text(encoding="utf-8"))
            if "providers" in raw and "codex" in (raw.get("providers") or {}):
                rec = raw["providers"]["codex"]
                rec.setdefault("id", "codex")
            elif isinstance(raw, dict):
                rec = normalize_codex(raw)
            else:
                rec = empty_provider("codex", "unknown", "bad_payload")
        else:
            raw = codex_rate_limits()
            if not isinstance(raw, dict):
                rec = empty_provider("codex", "unknown", "bad_payload")
            else:
                rec = normalize_codex(raw)
    except FileNotFoundError:
        rec = empty_provider("codex", "unknown", "no_cli")
    except Exception as exc:
        rec = empty_provider("codex", "unknown", redact(str(exc))[:200])
    if fixture is None:
        rec = attach_codex_local_stats(rec)
    return rec


# --- Token Plan --------------------------------------------------------------


def token_plan_conf() -> Path:
    return Path(
        os.environ.get(
            "AI_USAGE_TOKEN_PLAN_CONF",
            Path.home() / ".config" / "alibaba-token-plan",
        )
    )


def token_plan_identities() -> list[dict]:
    path = token_plan_conf() / "slots"
    out: list[dict] = []
    if not path.is_file():
        return out
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("|")
        sid = parts[0].strip()
        if not sid:
            continue
        title = parts[2].strip() if len(parts) > 2 else sid
        ident = parts[3].strip() if len(parts) > 3 else ""
        out.append({"id": sid, "label": sid, "title": title, "ident": ident})
    return out


def token_plan_active_id() -> str | None:
    path = token_plan_conf() / "active"
    if not path.is_file():
        return None
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return value or None


def cursor_oauth_conf() -> Path:
    return Path(
        os.environ.get(
            "AI_USAGE_CURSOR_OAUTH_CONF",
            Path.home() / ".config" / "cursor-oauth",
        )
    )


def cursor_oauth_identities() -> list[dict]:
    path = cursor_oauth_conf() / "slots"
    out: list[dict] = []
    if not path.is_file():
        return out
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split("|")
        sid = parts[0].strip()
        if not sid:
            continue
        title = parts[2].strip() if len(parts) > 2 else sid
        ident = parts[3].strip() if len(parts) > 3 else ""
        out.append({"id": sid, "label": sid, "title": title or sid, "ident": ident})
    return out


def cursor_oauth_active_id() -> str | None:
    path = cursor_oauth_conf() / "active"
    if not path.is_file():
        return None
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return value or None


def cursor_oauth_slot_file(sid: str) -> Path:
    return cursor_oauth_conf() / "identities" / sid / "auth.json"


def cursor_parked_identities() -> list[dict]:
    return [s for s in cursor_oauth_identities() if cursor_oauth_slot_file(s["id"]).is_file()]


def attach_cursor_identity(rec: dict) -> dict:
    parked = cursor_parked_identities()
    if not parked:
        return rec
    rec = dict(rec)
    active = cursor_oauth_active_id() or parked[0]["id"]
    match = next((s for s in parked if s["id"] == active), parked[0])
    rec["identity"] = {
        "id": match["id"],
        "label": match["id"],
        "title": match.get("title") or match["id"],
    }
    rec["identities"] = [{"id": s["id"], "label": s["id"]} for s in parked]
    return rec


def attach_token_plan_identity(rec: dict) -> dict:
    slots = token_plan_identities()
    if not slots:
        return rec
    active = token_plan_active_id() or slots[0]["id"]
    match = next((s for s in slots if s["id"] == active), slots[0])
    rec["identity"] = {
        "id": match["id"],
        "label": match["id"],
        "title": match.get("title") or match["id"],
    }
    rec["identities"] = [{"id": s["id"], "label": s["id"]} for s in slots]
    return rec


def _token_plan_number(value) -> int | float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    if number != number or number in (float("inf"), float("-inf")) or number < 0:
        return None
    return int(number) if number.is_integer() else number


def _token_plan_count(value) -> int | None:
    number = _token_plan_number(value)
    if number is None or float(number) != int(number):
        return None
    return int(number)


def _token_plan_timestamp(value) -> str | None:
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, str):
        value = value.strip()
        if not value or "T" not in value:
            return None
    elif not isinstance(value, (int, float)):
        return None
    stamp = parse_reset(value)
    if stamp is None:
        return None
    return stamp.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _empty_token_plan(reason: str) -> dict:
    return attach_token_plan_identity(
        {
            "id": "token-plan",
            "name": "Token Plan",
            "logo": "T",
            "status": "unknown",
            "reason": reason,
            "windows": [
                window("weekly", "Account average", None),
                window("special", "Hottest account", None),
            ],
            "account_usage": [],
            "capacity": {},
            "snapshot": {
                "reports": 0,
                "accounts_without_usage": 0,
                "disabled_credentials": 0,
            },
        }
    )


def _token_plan_report_usage(report: dict) -> dict:
    usage: dict = {}
    fetched_at = _token_plan_timestamp(report.get("fetchedAt"))
    if fetched_at:
        usage["fetched_at"] = fetched_at
    limits = report.get("limits")
    if not isinstance(limits, list):
        return usage
    for limit in limits:
        if not isinstance(limit, dict):
            continue
        win = limit.get("window")
        window_id = win.get("id") if isinstance(win, dict) else None
        if limit.get("id") != "credits:7d" or window_id != "7d":
            continue
        if limit.get("status") not in (None, "ok"):
            return usage
        amount = limit.get("amount")
        fraction = _token_plan_number(amount.get("usedFraction")) if isinstance(amount, dict) else None
        used_pct = as_pct(float(fraction) * 100.0) if fraction is not None and fraction <= 1 else None
        if used_pct is not None:
            usage["used_pct"] = used_pct
        resets_at = _token_plan_timestamp(
            limit.get("resetsAt") or (win.get("resetsAt") if isinstance(win, dict) else None)
        )
        if resets_at:
            usage["resets_at"] = resets_at
        return usage
    return usage


def _token_plan_capacity(payload: dict) -> dict:
    capacity_root = payload.get("capacity")
    if not isinstance(capacity_root, dict):
        return {}
    rows = capacity_root.get("alibaba-token-plan")
    if not isinstance(rows, list):
        return {}
    for row in rows:
        if not isinstance(row, dict) or row.get("window") != "7d":
            continue
        capacity: dict = {}
        accounts = _token_plan_count(row.get("accounts"))
        used_accounts = _token_plan_number(row.get("usedAccounts"))
        remaining_accounts = _token_plan_number(row.get("remainingAccounts"))
        if accounts is not None:
            capacity["accounts"] = accounts
        if used_accounts is not None:
            capacity["used_accounts"] = used_accounts
        if remaining_accounts is not None:
            capacity["remaining_accounts"] = remaining_accounts
        return capacity
    return {}


def probe_token_plan() -> dict:
    omp = os.environ.get("AI_USAGE_OMP_BIN") or which("omp")
    if not omp:
        return _empty_token_plan("no_cli")
    try:
        proc = subprocess.run(
            [omp, "usage", "--provider", "alibaba-token-plan", "--json"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
            env=child_env(),
        )
    except subprocess.TimeoutExpired:
        return _empty_token_plan("timeout")
    except OSError:
        return _empty_token_plan("no_cli")
    if proc.returncode:
        return _empty_token_plan(f"exit_{proc.returncode}")
    try:
        payload = json.loads(proc.stdout) if proc.stdout and proc.stdout.strip() else None
    except json.JSONDecodeError:
        return _empty_token_plan("no_json")
    if not isinstance(payload, dict) or not isinstance(payload.get("reports"), list):
        return _empty_token_plan("bad_payload")
    if "capacity" in payload and not isinstance(payload.get("capacity"), dict):
        return _empty_token_plan("bad_payload")

    raw_reports = payload["reports"]
    account_usage = [
        _token_plan_report_usage(report)
        for report in raw_reports
        if isinstance(report, dict) and report.get("provider") == "alibaba-token-plan"
    ]
    capacity = _token_plan_capacity(payload)
    capacity_declared = bool(payload.get("capacity"))
    accounts_without_usage = payload.get("accountsWithoutUsage")
    disabled_credentials = payload.get("disabledCredentials")
    usage_lists_valid = isinstance(accounts_without_usage, list) and isinstance(disabled_credentials, list)
    missing_count = len(accounts_without_usage) if isinstance(accounts_without_usage, list) else 0
    disabled_count = len(disabled_credentials) if isinstance(disabled_credentials, list) else 0
    snapshot = {
        "reports": len(account_usage),
        "accounts_without_usage": missing_count,
        "disabled_credentials": disabled_count,
    }

    accounts = capacity.get("accounts")
    used_accounts = capacity.get("used_accounts")
    remaining_accounts = capacity.get("remaining_accounts")
    consistent_capacity = (
        isinstance(accounts, int)
        and accounts > 0
        and used_accounts is not None
        and remaining_accounts is not None
        and abs(float(used_accounts) + float(remaining_accounts) - accounts)
        <= max(1e-6, accounts * 1e-6)
    )
    report_pcts = [as_pct(item.get("used_pct")) for item in account_usage]
    complete_reports = (
        bool(account_usage)
        and len(raw_reports) == len(account_usage)
        and isinstance(accounts_without_usage, list)
        and missing_count == 0
        and all(pct is not None for pct in report_pcts)
    )
    if consistent_capacity:
        average = ratio(used_accounts, accounts)
        complete_coverage = complete_reports and len(account_usage) == accounts
        average_accounts = accounts
    else:
        average = as_pct(sum(report_pcts) / len(report_pcts)) if complete_reports else None
        complete_coverage = complete_reports
        average_accounts = len(account_usage) if complete_reports else None
    hottest = max(report_pcts) if complete_coverage else None
    average_label = f"{average_accounts}-account average" if average_accounts else "Account average"
    windows = [
        window("weekly", average_label, average),
        window("special", "Hottest account", hottest),
    ]
    status = "ok" if average is not None else "unknown"
    rec = {
        "id": "token-plan",
        "name": "Token Plan",
        "logo": "T",
        "status": status,
        "windows": windows,
        "account_usage": account_usage,
        "capacity": capacity,
        "snapshot": snapshot,
    }
    timestamps = [item.get("fetched_at") for item in account_usage]
    timestamps_complete = (
        bool(timestamps)
        and len(raw_reports) == len(account_usage)
        and (not consistent_capacity or len(account_usage) == accounts)
        and all(isinstance(stamp, str) for stamp in timestamps)
    )
    if timestamps_complete:
        rec["measured_at"] = min(timestamps)
    partial = (
        not complete_coverage
        or disabled_count > 0
        or not usage_lists_valid
        or not timestamps_complete
        or (capacity_declared and not consistent_capacity)
    )
    if status != "ok":
        rec["reason"] = "no_used_pct"
    elif partial:
        rec["reason"] = "partial_usage"
    return attach_token_plan_identity(rec)


# --- Grok --------------------------------------------------------------------

KIMI_CLIENT_ID = "17e5f671-d194-4dfb-9706-5516cb48c098"
KIMI_DEFAULT_BASE = "https://api.kimi.ai/coding/v1"
KIMI_DEFAULT_OAUTH = "https://auth.kimi.ai"
KIMI_USER_AGENT = "kimi-code/0.38.0"


class _KimiUnauth(Exception):
    pass


def _rpc_error_text(err) -> str:
    if isinstance(err, dict):
        parts = [err.get("message"), err.get("data"), err.get("code")]
        msg = " ".join(str(p) for p in parts if p is not None)
        return redact(msg or str(err))
    return redact(str(err))


def grok_billing() -> dict:
    bin_path = grok_bin()
    if not bin_path:
        raise FileNotFoundError("grok")
    proc = subprocess.Popen(
        [bin_path, "agent", "--no-leader", "stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=child_env(),
        start_new_session=True,
    )
    buf = bytearray()
    deadline = time.time() + RPC_TIMEOUT_SEC
    try:
        _send(
            proc,
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": 1,
                    "clientCapabilities": {"fs": {}, "terminal": False},
                    "_meta": {
                        "startupHints": {
                            "nonInteractive": True,
                            "skipGitStatus": True,
                            "skipProjectLayout": True,
                        },
                        "clientType": "omarchy-usage-tray",
                        "clientVersion": "0.2.0",
                    },
                },
            },
        )
        init = _recv_until(proc, lambda m: _id_match(m, 1), deadline, buf)
        if "error" in init:
            raise RuntimeError(_rpc_error_text(init["error"]))
        _send(proc, {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}})
        _send(proc, {"jsonrpc": "2.0", "id": 2, "method": "_x.ai/billing", "params": {}})
        billed = _recv_until(proc, lambda m: _id_match(m, 2), deadline, buf)
        if "error" in billed:
            raise RuntimeError(_rpc_error_text(billed["error"]))
        result = billed.get("result")
        if not isinstance(result, dict):
            raise RuntimeError("billing missing result")
        return result
    finally:
        try:
            if proc.stdin:
                proc.stdin.close()
        except OSError:
            pass
        try:
            proc.kill()
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            pass


def _cents(value) -> int | None:
    if isinstance(value, dict) and "val" in value:
        try:
            return int(value.get("val") or 0)
        except (TypeError, ValueError):
            return None
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return int(value)
    return None


def grok_team_id() -> str | None:
    path = Path.home() / ".grok" / "auth.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    for entry in data.values():
        if isinstance(entry, dict) and isinstance(entry.get("team_id"), str) and entry["team_id"]:
            return entry["team_id"]
    return None


def grok_management_prepaid() -> dict | None:
    """Business/API prepaid via management API. Needs XAI_MANAGEMENT_KEY or XAI_API_KEY (not OAuth)."""
    key = os.environ.get("XAI_MANAGEMENT_KEY") or os.environ.get("XAI_API_KEY")
    if not key:
        return None
    team = grok_team_id()
    if not team:
        return {"error": "no_team_id"}
    url = f"https://management-api.x.ai/v1/billing/teams/{team}/prepaid/balance"
    headers = {"Accept": "application/json", "User-Agent": "omarchy-usage-tray/0.2"}
    last = None
    for auth_header in ({"Authorization": "Bearer " + key}, {"X-Api-Key": key}):
        req = urllib.request.Request(url, headers={**headers, **auth_header}, method="GET")
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            last = f"http_{exc.code}"
            continue
        except Exception as exc:
            last = redact(str(exc))[:80]
            continue
        if not isinstance(payload, dict):
            last = "bad_payload"
            continue
        remaining = None
        limit = None
        for path in (
            ("remaining_balance",),
            ("balance",),
            ("remaining",),
            ("amount_remaining",),
            ("prepaid_balance",),
            ("credits", "remaining"),
        ):
            cur: object = payload
            ok = True
            for part in path:
                if not isinstance(cur, dict) or part not in cur:
                    ok = False
                    break
                cur = cur[part]
            if ok:
                try:
                    remaining = float(cur)
                    break
                except (TypeError, ValueError):
                    pass
        if remaining is None:
            # cents-style {val: N}
            val = payload.get("val") or payload.get("amount")
            if isinstance(val, dict) and "val" in val:
                remaining = float(val["val"]) / 100.0
            elif isinstance(val, (int, float)) and val > 1000:
                remaining = float(val) / 100.0
            elif isinstance(val, (int, float)):
                remaining = float(val)
        if remaining is None:
            last = "no_remaining_field"
            continue
        if remaining > 10000:
            remaining = remaining / 100.0  # cents
        for lim_key in ("limit", "prepaid_limit", "total"):
            if lim_key in payload:
                try:
                    limit = float(payload[lim_key])
                    if limit > 10000:
                        limit = limit / 100.0
                except (TypeError, ValueError):
                    limit = None
        return {"remaining_usd": remaining, "limit_usd": limit, "source": "management-api"}
    return {"error": last or "unauth"}


def grok_api_credits_window(config: dict, api_prepaid: dict | None = None) -> dict | None:
    """Second SuperGrok meter: business API credits (management key), not OAuth prepaid=0."""
    if isinstance(api_prepaid, dict) and api_prepaid.get("remaining_usd") is not None:
        rem = float(api_prepaid["remaining_usd"])
        extra = {"remaining_usd": rem, "source": api_prepaid.get("source") or "management-api"}
        lim = api_prepaid.get("limit_usd")
        if isinstance(lim, (int, float)) and lim > 0:
            extra["limit_usd"] = float(lim)
            used_pct = as_pct(100.0 * max(0.0, (float(lim) - rem) / float(lim)))
            return window("credits", "API credits", used_pct, extra=extra)
        return window("credits", "API credits", None, extra=extra)
    cap = _cents(config.get("onDemandCap"))
    used = _cents(config.get("onDemandUsed"))
    prepaid = _cents(config.get("prepaidBalance"))
    extra: dict = {}
    if cap is not None and cap > 0:
        spent = 0 if used is None else abs(used)
        pct = as_pct(100.0 * spent / cap)
        extra["on_demand_cap_cents"] = cap
        extra["on_demand_used_cents"] = spent
        extra["remaining_usd"] = max(0, cap - spent) / 100.0
        return window("credits", "API credits", pct, extra=extra)
    if prepaid is not None and abs(prepaid) > 0:
        rem = abs(prepaid) / 100.0
        extra["remaining_usd"] = rem
        extra["source"] = "oauth-prepaid"
        return window("credits", "API credits", None, extra=extra)
    return None


def normalize_grok(raw: dict, api_prepaid: dict | None = None) -> dict:
    rec = {
        "id": "grok",
        "name": "Grok",
        "logo": "G",
        "status": "unknown",
        "windows": [{"kind": "weekly", "label": "Weekly"}],
    }
    config = raw.get("config") if isinstance(raw.get("config"), dict) else {}
    if not config:
        rec["reason"] = "no_config"
        return rec
    tier = raw.get("subscription_tier")
    if tier:
        rec["plan"] = str(tier)
    period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
    ptype = str(period.get("type") or "")
    resets = period.get("end") or config.get("billingPeriodEnd")
    resets_at = resets if isinstance(resets, str) else iso_from_unix(resets)
    pct = config.get("creditUsagePercent")
    windows: list[dict] = []
    if "WEEKLY" in ptype.upper() or not ptype:
        if pct is None and "WEEKLY" in ptype.upper():
            pct = 0
        weekly = window("weekly", "Weekly", as_pct(pct), resets_at)
        windows.append(weekly)
    cred = grok_api_credits_window(config, api_prepaid)
    if cred:
        windows.append(cred)
    rec["windows"] = windows or rec["windows"]
    if any("used_pct" in w or (w.get("extra") or {}).get("remaining_usd") is not None for w in rec["windows"]):
        rec["status"] = "ok"
    else:
        rec["reason"] = "no_used_pct"
    if isinstance(api_prepaid, dict) and api_prepaid.get("error"):
        rec.setdefault("reason", api_prepaid["error"])
    return rec


def probe_grok() -> dict:
    api_prepaid = grok_management_prepaid()
    try:
        raw = grok_billing()
    except FileNotFoundError:
        return empty_provider("grok", "unknown", "no_cli")
    except Exception as exc:
        msg = redact(str(exc))[:200]
        low = msg.lower()
        if "auth" in low or "login" in low:
            return empty_provider("grok", "unauth", "need_grok_login")
        if "method not found" in low or "-32601" in msg:
            return empty_provider("grok", "unknown", "acp_method_not_found")
        return empty_provider("grok", "unknown", msg or "probe_failed")
    if not isinstance(raw, dict):
        return empty_provider("grok", "unknown", "bad_payload")
    return normalize_grok(raw, api_prepaid if isinstance(api_prepaid, dict) and "remaining_usd" in api_prepaid else api_prepaid)


# --- Kimi --------------------------------------------------------------------


def _toml_section(text: str, header: str) -> str:
    m = re.search(rf"^\[{re.escape(header)}\]\s*$", text, re.M)
    if not m:
        return ""
    rest = text[m.end() :]
    nxt = re.search(r"^\[", rest, re.M)
    return rest[: nxt.start()] if nxt else rest


def _toml_str(section: str, key: str) -> str | None:
    m = re.search(rf"^{re.escape(key)}\s*=\s*\"([^\"]*)\"", section, re.M)
    return m.group(1) if m else None


def _kimi_config() -> tuple[str, str, str]:
    base = os.environ.get("KIMI_CODE_BASE_URL") or ""
    oauth_host = os.environ.get("KIMI_CODE_OAUTH_HOST") or ""
    key = os.environ.get("KIMI_CODE_OAUTH_KEY") or ""
    cfg = Path.home() / ".kimi-code" / "config.toml"
    try:
        text = cfg.read_text(encoding="utf-8")
    except OSError:
        text = ""
    if text:
        prov = _toml_section(text, 'providers."managed:kimi-code"')
        oauth = _toml_section(text, 'providers."managed:kimi-code".oauth')
        if not base:
            base = _toml_str(prov, "base_url") or ""
        if not oauth_host:
            oauth_host = _toml_str(oauth, "oauth_host") or ""
        if not key:
            key = _toml_str(oauth, "key") or ""
    base = (base or KIMI_DEFAULT_BASE).rstrip("/")
    oauth_host = (oauth_host or KIMI_DEFAULT_OAUTH).rstrip("/")
    slot = key[6:] if key.startswith("oauth/") else key
    return base, oauth_host, slot


def _kimi_cred_paths(slot: str) -> tuple[Path | None, Path | None]:
    cred_dir = Path.home() / ".kimi-code" / "credentials"
    lock_dir = Path.home() / ".kimi-code" / "oauth"
    if slot:
        return cred_dir / f"{slot}.json", lock_dir / slot
    if not cred_dir.is_dir():
        return None, None
    files = sorted(
        (p for p in cred_dir.glob("*.json") if p.stat().st_size > 0),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not files:
        return None, None
    path = files[0]
    return path, lock_dir / path.stem


def _kimi_read_creds(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def _kimi_is_tombstone(data: dict) -> bool:
    access = data.get("access_token")
    refresh = data.get("refresh_token")
    if not access and not refresh:
        return True
    try:
        if data.get("expires_at") is not None and float(data.get("expires_at")) == 0 and not access:
            return True
    except (TypeError, ValueError):
        pass
    return False


def _kimi_needs_refresh(data: dict) -> bool:
    if not data.get("access_token"):
        return True
    ea = data.get("expires_at")
    if ea is None or ea == "":
        return True
    try:
        n = float(ea)
    except (TypeError, ValueError):
        return True
    if n >= 1e12:
        n = n / 1000.0
    return n - time.time() < 300


def _kimi_write_creds(path: Path, data: dict) -> None:
    ensure_dir(path.parent, 0o700)
    payload = json.dumps(data, ensure_ascii=False, separators=(",", ":"))
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".tmp.", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(payload)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        try:
            os.chmod(path, 0o600)
        except OSError:
            pass
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _kimi_flock(lock_path: Path) -> int:
    ensure_dir(lock_path.parent, 0o700)
    fd = os.open(str(lock_path), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        pass
    deadline = time.time() + 10
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.time() >= deadline:
                os.close(fd)
                raise TimeoutError("kimi_oauth_lock")
            time.sleep(0.05)


def _kimi_unflock(fd: int) -> None:
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def _kimi_http(url: str, method: str, headers: dict, data: bytes | None = None, timeout: float = 10):
    hdrs = dict(headers)
    hdrs.setdefault("User-Agent", KIMI_USER_AGENT)
    hdrs.setdefault("Accept", "application/json")
    req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return getattr(resp, "status", 200), resp.read()
    except urllib.error.HTTPError as exc:
        body = b""
        try:
            body = exc.read()
        except Exception:
            pass
        return exc.code, body


def _kimi_decode(body: bytes | None):
    if not body:
        return None
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def _kimi_cloudflare(payload) -> bool:
    if not isinstance(payload, dict):
        return False
    if payload.get("cloudflare_error"):
        return True
    name = str(payload.get("error_name") or "").lower()
    cat = str(payload.get("error_category") or "").lower()
    return "cloudflare" in name or "cloudflare" in cat or name == "browser_signature_banned"


def _kimi_refresh(oauth_host: str, refresh_token: str) -> dict:
    url = oauth_host.rstrip("/") + "/api/oauth/token"
    form = urlencode(
        {
            "client_id": KIMI_CLIENT_ID,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        }
    ).encode("ascii")
    headers = {
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "application/json",
    }
    last_err = "refresh_failed"
    for attempt in range(3):
        code, body = _kimi_http(url, "POST", headers, form, timeout=30)
        if code in (429, 500, 502, 503, 504):
            time.sleep(2**attempt)
            last_err = f"http_{code}"
            continue
        payload = _kimi_decode(body)
        if _kimi_cloudflare(payload):
            raise RuntimeError(f"http_{code}")
        err = None
        if isinstance(payload, dict):
            raw_err = payload.get("error")
            if isinstance(raw_err, str):
                err = raw_err
            elif isinstance(raw_err, dict):
                err = str(raw_err.get("code") or raw_err.get("error") or "")
            else:
                err = str(payload.get("code") or "") or None
        if code in (401, 403) or err in ("invalid_grant", "unauthenticated"):
            if err == "invalid_grant" or code == 401 or err == "unauthenticated":
                raise _KimiUnauth("need_login")
            raise RuntimeError(f"http_{code}")
        if isinstance(payload, dict):
            if code >= 400:
                raise RuntimeError(f"http_{code}")
            access = payload.get("access_token")
            rotated = payload.get("refresh_token")
            expires_in = payload.get("expires_in")
            if not isinstance(access, str) or not access or not isinstance(rotated, str) or not rotated:
                raise RuntimeError("bad_refresh")
            try:
                exp = int(expires_in)
            except (TypeError, ValueError):
                raise RuntimeError("bad_refresh")
            if exp <= 0:
                raise RuntimeError("bad_refresh")
            out = {
                "access_token": access,
                "refresh_token": rotated,
                "expires_in": exp,
                "token_type": payload.get("token_type") or "Bearer",
                "expires_at": int(time.time()) + exp,
            }
            if payload.get("scope"):
                out["scope"] = payload.get("scope")
            return out
        last_err = f"http_{code}" if code >= 400 else "bad_refresh"
        break
    raise RuntimeError(last_err)


def _kimi_usages(base: str, access: str) -> tuple[int, dict | None]:
    url = base.rstrip("/") + "/usages"
    headers = {"Authorization": "Bearer " + access, "Accept": "application/json"}
    code, body = _kimi_http(url, "GET", headers, None, timeout=10)
    return code, _kimi_decode(body)


def _kimi_window_is_5h(item: dict) -> bool:
    win = item.get("window")
    unit = ""
    dur_f = None
    if isinstance(win, dict):
        unit = str(win.get("timeUnit") or win.get("unit") or "").lower()
        try:
            dur_f = float(win.get("duration"))
        except (TypeError, ValueError):
            dur_f = None
    elif win is not None:
        s = str(win).lower()
        return s in ("5h", "5hr", "300m", "300 minutes")
    else:
        unit = str(item.get("timeUnit") or item.get("unit") or "").lower()
        try:
            dur_f = float(item.get("duration"))
        except (TypeError, ValueError):
            dur_f = None
    if dur_f is None:
        return False
    if "minute" in unit and dur_f == 300:
        return True
    if "hour" in unit and dur_f == 5:
        return True
    if "minute" in unit and dur_f >= 60 and dur_f % 60 == 0 and dur_f / 60 == 5:
        return True
    return False


def _kimi_detail_reset(detail: dict):
    reset = detail.get("resetTime") or detail.get("resetsAt")
    if isinstance(reset, (int, float)):
        return iso_from_unix(reset)
    if reset is not None:
        return str(reset)
    return None


def _kimi_pct(detail: dict) -> float | None:
    if not isinstance(detail, dict):
        return None
    pct = ratio(detail.get("used"), detail.get("limit"))
    if pct is not None:
        return pct
    if detail.get("remaining") is None or detail.get("limit") is None:
        return None
    try:
        rem = float(detail.get("remaining"))
        lim = float(detail.get("limit"))
    except (TypeError, ValueError):
        return None
    if lim <= 0:
        return None
    return as_pct(100.0 * (lim - rem) / lim)


def _kimi_windows(payload: dict) -> list[dict]:
    windows: list[dict] = []
    usage = payload.get("usage") if isinstance(payload.get("usage"), dict) else None
    if usage:
        pct = _kimi_pct(usage)
        reset = usage.get("resetTime") or usage.get("resetsAt") or usage.get("reset_at")
        if isinstance(reset, (int, float)):
            reset = iso_from_unix(reset)
        elif reset is not None:
            reset = str(reset)
        if pct is not None:
            windows.append(window("weekly", "Weekly", pct, reset))
    limits = payload.get("limits") if isinstance(payload.get("limits"), list) else []
    for item in limits:
        if not isinstance(item, dict) or not _kimi_window_is_5h(item):
            continue
        detail = item.get("detail") if isinstance(item.get("detail"), dict) else item
        if not isinstance(detail, dict):
            continue
        pct = _kimi_pct(detail)
        if pct is None:
            continue
        windows.append(window("session", "5h", pct, _kimi_detail_reset(detail), extra={"window_mins": 300}))
        break
    if not any(w.get("kind") == "weekly" for w in windows):
        windows.insert(0, {"kind": "weekly", "label": "Weekly"})
    return windows


def probe_kimi() -> dict:
    base, oauth_host, slot = _kimi_config()
    cred_path, lock_path = _kimi_cred_paths(slot)
    if cred_path is None or lock_path is None or not cred_path.is_file():
        return empty_provider("kimi", "unauth", "need_login")

    def load() -> dict | None:
        return _kimi_read_creds(cred_path)

    def refresh_locked(old: dict) -> dict:
        rt = old.get("refresh_token")
        if not isinstance(rt, str) or not rt:
            raise _KimiUnauth("need_login")
        new = _kimi_refresh(oauth_host, rt)
        merged = dict(old)
        merged.update(new)
        _kimi_write_creds(cred_path, merged)
        return merged

    creds: dict | None
    try:
        fd = _kimi_flock(lock_path)
        try:
            creds = load()
            if not creds or _kimi_is_tombstone(creds):
                return empty_provider("kimi", "unauth", "need_login")
            if _kimi_needs_refresh(creds):
                creds = refresh_locked(creds)
        finally:
            _kimi_unflock(fd)
    except _KimiUnauth:
        return empty_provider("kimi", "unauth", "need_login")
    except TimeoutError:
        return empty_provider("kimi", "unknown", "lock_timeout")
    except Exception as exc:
        msg = redact(str(exc))[:200]
        low = msg.lower()
        if "invalid_grant" in low or "401" in msg or "unauth" in low:
            return empty_provider("kimi", "unauth", "need_login")
        return empty_provider("kimi", "unknown", msg or "refresh_failed")

    access = creds.get("access_token") if isinstance(creds, dict) else None
    if not isinstance(access, str) or not access:
        return empty_provider("kimi", "unauth", "need_login")

    def usages_unauth(code, payload) -> bool:
        if _kimi_cloudflare(payload):
            return False
        if code == 401:
            return True
        if not isinstance(payload, dict):
            return False
        code_s = str(payload.get("code") or payload.get("error") or "").lower()
        if code_s in ("unauthenticated", "invalid_grant", "unauthorized"):
            return True
        details = payload.get("details")
        if isinstance(details, list):
            for item in details:
                if not isinstance(item, dict):
                    continue
                dbg = item.get("debug") if isinstance(item.get("debug"), dict) else {}
                if "INVALID_AUTH" in str(dbg.get("reason") or ""):
                    return True
        return False

    try:
        code, payload = _kimi_usages(base, access)
    except Exception as exc:
        return empty_provider("kimi", "unknown", redact(str(exc))[:200])

    if usages_unauth(code, payload):
        try:
            fd = _kimi_flock(lock_path)
            try:
                creds = load()
                if not creds or _kimi_is_tombstone(creds):
                    return empty_provider("kimi", "unauth", "need_login")
                creds = refresh_locked(creds)
            finally:
                _kimi_unflock(fd)
        except _KimiUnauth:
            return empty_provider("kimi", "unauth", "need_login")
        except Exception as exc:
            msg = redact(str(exc))[:200]
            if "invalid_grant" in msg.lower():
                return empty_provider("kimi", "unauth", "need_login")
            return empty_provider("kimi", "unknown", msg)
        access = creds.get("access_token") if isinstance(creds, dict) else None
        if not isinstance(access, str) or not access:
            return empty_provider("kimi", "unauth", "need_login")
        try:
            code, payload = _kimi_usages(base, access)
        except Exception as exc:
            return empty_provider("kimi", "unknown", redact(str(exc))[:200])
        if usages_unauth(code, payload):
            return empty_provider("kimi", "unauth", "need_login")

    if code != 200 or not isinstance(payload, dict):
        if usages_unauth(code, payload):
            return empty_provider("kimi", "unauth", "need_login")
        return empty_provider("kimi", "unknown", f"http_{code}" if code else "bad_payload")

    rec = {
        "id": "kimi",
        "name": "Kimi",
        "logo": "K",
        "status": "ok",
        "windows": _kimi_windows(payload),
    }
    if not any("used_pct" in w for w in rec["windows"]):
        rec["status"] = "unknown"
        rec["reason"] = "no_used_pct"
    return rec


# --- Cursor ------------------------------------------------------------------

CURSOR_USAGE_URL = "https://cursor.com/api/usage-summary"
CURSOR_SESSION_COOKIE = "WorkosCursorSessionToken"
CURSOR_DEFAULT_USER_AGENT = "cursor-agent/0.1.0"


class _CursorRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Never forward the session cookie to a non-cursor.com redirect target."""

    def redirect_request(self, oldreq, fp, code, msg, headers, newurl):
        newreq = super().redirect_request(oldreq, fp, code, msg, headers, newurl)
        if newreq is None:
            return None
        old_host = urllib.parse.urlparse(oldreq.full_url).hostname or ""
        new_host = urllib.parse.urlparse(newurl).hostname or ""
        if old_host.lower() != new_host.lower():
            newreq.remove_header("Cookie")
        return newreq


_CURSOR_OPENER = urllib.request.build_opener(_CursorRedirectHandler)


def _cursor_agent_version() -> str:
    explicit = os.environ.get("CURSOR_AGENT_VERSION")
    if explicit:
        return explicit
    bin_path = which("cursor-agent")
    if not bin_path:
        return CURSOR_DEFAULT_USER_AGENT
    try:
        proc = subprocess.run(
            [bin_path, "--version"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
            env=child_env(),
        )
        version = (proc.stdout or "").strip().splitlines()[0]
        if version:
            return "cursor-agent/" + version.split("-")[0]
    except Exception:
        pass
    return CURSOR_DEFAULT_USER_AGENT


def _cursor_user_agent() -> str:
    return _cursor_agent_version()


def _cursor_auth_path() -> Path:
    return Path(os.environ.get("CURSOR_AUTH_FILE") or (Path.home() / ".config" / "cursor" / "auth.json"))


def _cursor_read_token() -> str | None:
    explicit = os.environ.get("CURSOR_OAUTH_TOKEN")
    if explicit:
        return explicit
    path = _cursor_auth_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    token = data.get("accessToken")
    return token if isinstance(token, str) and token else None


def _cursor_user_id(token: str) -> str | None:
    try:
        parts = token.split(".")
        if len(parts) < 2:
            return None
        payload = json.loads(base64.urlsafe_b64decode(parts[1] + "==").decode("utf-8"))
    except Exception:
        return None
    sub = payload.get("sub") if isinstance(payload, dict) else None
    if not isinstance(sub, str):
        return None
    if "|" in sub:
        return sub.split("|")[-1]
    return sub


def _cursor_cookie(token: str) -> str | None:
    uid = _cursor_user_id(token)
    if not uid:
        return None
    return f"{CURSOR_SESSION_COOKIE}={uid}%3A%3A{token}"


def _cursor_http(url: str, cookie: str) -> tuple[int, dict | None]:
    headers = {
        "Accept": "application/json",
        "Cookie": cookie,
        "User-Agent": _cursor_user_agent(),
    }
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with _CURSOR_OPENER.open(req, timeout=15) as resp:
            body = resp.read()
    except urllib.error.HTTPError as exc:
        body = b""
        try:
            body = exc.read()
        except Exception:
            pass
        return exc.code, _cursor_decode(body)
    except Exception as exc:
        raise RuntimeError(redact(str(exc))[:200])
    return getattr(resp, "status", 200), _cursor_decode(body)


def _cursor_decode(body: bytes | None) -> dict | None:
    if not body:
        return None
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def _cursor_usages() -> dict | None:
    token = _cursor_read_token()
    if not token:
        return None
    cookie = _cursor_cookie(token)
    if not cookie:
        return None
    code, payload = _cursor_http(CURSOR_USAGE_URL, cookie)
    if code in (401, 403):
        raise _KimiUnauth("need_cursor_login")
    if code != 200 or not isinstance(payload, dict):
        raise RuntimeError(f"http_{code}" if code else "bad_payload")
    return payload


def normalize_cursor(raw: dict) -> dict:
    rec = {
        "id": "cursor",
        "name": "Cursor",
        "logo": "R",
        "status": "unknown",
        "windows": [],
    }
    membership = raw.get("membershipType")
    if membership:
        rec["plan"] = str(membership)
    individual = raw.get("individualUsage") if isinstance(raw.get("individualUsage"), dict) else {}
    plan = individual.get("plan") if isinstance(individual.get("plan"), dict) else {}
    billing_end = raw.get("billingCycleEnd")
    resets_at = str(billing_end) if isinstance(billing_end, str) else None
    total_pct = as_pct(plan.get("totalPercentUsed"))
    auto_pct = as_pct(plan.get("autoPercentUsed"))
    windows: list[dict] = []
    if total_pct is not None:
        windows.append(window("weekly", "Weekly", total_pct, resets_at))
    else:
        windows.append({"kind": "weekly", "label": "Weekly"})
    if auto_pct is not None:
        windows.append(window("special", "Auto", auto_pct, resets_at))
    else:
        windows.append({"kind": "special", "label": "Auto"})
    on_demand = individual.get("onDemand") if isinstance(individual.get("onDemand"), dict) else {}
    if on_demand.get("enabled"):
        remaining = on_demand.get("remaining")
        limit = on_demand.get("limit")
        used = on_demand.get("used")
        extra: dict = {}
        rem_usd = None
        if isinstance(remaining, (int, float)) and remaining is not None:
            rem_usd = float(remaining) / 100.0
        elif isinstance(limit, (int, float)) and isinstance(used, (int, float)) and limit > 0:
            rem_usd = max(0.0, float(limit) - float(used)) / 100.0
        if rem_usd is not None:
            extra["remaining_usd"] = rem_usd
            windows.append(window("credits", "On-demand", None, extra=extra))
    rec["windows"] = windows
    if any("used_pct" in w for w in windows):
        rec["status"] = "ok"
    else:
        rec["reason"] = "no_used_pct"
    return attach_cursor_identity(rec)


def probe_cursor(fixture: str | None = None) -> dict:
    if fixture:
        try:
            raw = json.loads(Path(fixture).read_text(encoding="utf-8"))
            if "providers" in raw and "cursor" in (raw.get("providers") or {}):
                rec = raw["providers"]["cursor"]
                rec.setdefault("id", "cursor")
                return attach_cursor_identity(rec)
            if isinstance(raw, dict):
                return normalize_cursor(raw)
        except (OSError, json.JSONDecodeError):
            pass
        return attach_cursor_identity(empty_provider("cursor", "unknown", "bad_payload"))
    try:
        raw = _cursor_usages()
        if raw is None:
            return attach_cursor_identity(empty_provider("cursor", "unauth", "need_cursor_login"))
        if not isinstance(raw, dict):
            return attach_cursor_identity(empty_provider("cursor", "unknown", "bad_payload"))
        return normalize_cursor(raw)
    except _KimiUnauth:
        return attach_cursor_identity(empty_provider("cursor", "unauth", "need_cursor_login"))
    except FileNotFoundError:
        return attach_cursor_identity(empty_provider("cursor", "unauth", "need_cursor_login"))
    except Exception as exc:
        msg = redact(str(exc))[:200]
        low = msg.lower()
        if "auth" in low or "login" in low or "401" in msg:
            return attach_cursor_identity(empty_provider("cursor", "unauth", "need_cursor_login"))
        return attach_cursor_identity(empty_provider("cursor", "unknown", msg or "probe_failed"))


# --- Local Codex tokens (Quattro scan_native_codex_sessions) -----------------


def _tok_int(value) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def _model_name(raw) -> str:
    value = str(raw or "codex")
    return value if value else "codex"


def _local_day(value) -> str:
    if value is None:
        return datetime.now().strftime("%Y-%m-%d")
    if isinstance(value, (int, float)):
        if value > 10_000_000_000:
            value = value / 1000
        try:
            return datetime.fromtimestamp(value).strftime("%Y-%m-%d")
        except (OSError, OverflowError, ValueError):
            return datetime.now().strftime("%Y-%m-%d")
    text = str(value)
    try:
        if text.endswith("Z"):
            dt = datetime.fromisoformat(text[:-1] + "+00:00")
        else:
            dt = datetime.fromisoformat(text)
        if dt.tzinfo is not None:
            dt = dt.astimezone()
        return dt.strftime("%Y-%m-%d")
    except Exception:
        return datetime.now().strftime("%Y-%m-%d")


def _empty_bucket() -> dict:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def empty_local_stats() -> dict:
    now = datetime.now()
    dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": day, "messageCount": 0} for day in dates],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
        "hasLocalStats": False,
    }


def scan_native_codex_sessions() -> dict:
    """Quattro algorithm: last_token_usage only, jsonl mtime within 30d.

    Session tokens are never quota percents.
    """
    stats = empty_local_stats()
    now = datetime.now()
    today = now.strftime("%Y-%m-%d")
    recent_dates = [row["date"] for row in stats["recentDays"]]
    recent = {day: 0 for day in recent_dates}
    model_usage: dict[str, dict] = {}
    today_tokens_by_model: dict[str, int] = {}
    today_sessions: set[str] = set()
    total_sessions: set[str] = set()
    active_days: set[str] = set()
    today_prompts = 0
    today_total_tokens = 0
    total_prompts = 0

    codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
    roots = [codex_home / "sessions", codex_home / "archived_sessions"]
    files: list[Path] = []
    cutoff = time.time() - 30 * 24 * 60 * 60
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                if path.stat().st_mtime >= cutoff:
                    files.append(path)
            except OSError:
                pass

    saw_any = False
    for path in files:
        current_model = "codex"
        try:
            with path.open(errors="replace") as handle:
                for raw in handle:
                    try:
                        entry = json.loads(raw)
                    except Exception:
                        continue
                    if entry.get("type") == "turn_context":
                        payload = entry.get("payload") or {}
                        current_model = _model_name(
                            payload.get("model") or payload.get("model_slug") or current_model
                        )
                        continue
                    payload = entry.get("payload") or entry
                    if entry.get("type") == "response_item" and isinstance(payload, dict):
                        payload = payload.get("payload") or payload
                    if not isinstance(payload, dict):
                        continue
                    if payload.get("type") != "token_count":
                        continue
                    info = payload.get("info") or {}
                    usage = info.get("last_token_usage") or {}
                    if not isinstance(usage, dict):
                        continue
                    cache_read = _tok_int(usage.get("cached_input_tokens"))
                    cache_write = _tok_int(usage.get("cache_write_input_tokens"))
                    input_tokens = max(0, _tok_int(usage.get("input_tokens")) - cache_read - cache_write)
                    output_tokens = _tok_int(usage.get("output_tokens"))
                    if not (input_tokens or output_tokens or cache_read or cache_write):
                        continue
                    saw_any = True
                    day = _local_day(entry.get("timestamp") or path.stat().st_mtime)
                    session_key = str(path)
                    total = input_tokens + output_tokens + cache_read + cache_write
                    total_prompts += 1
                    total_sessions.add(session_key)
                    active_days.add(day)
                    bucket = model_usage.setdefault(current_model, _empty_bucket())
                    bucket["inputTokens"] += input_tokens
                    bucket["outputTokens"] += output_tokens
                    bucket["cacheReadInputTokens"] += cache_read
                    bucket["cacheCreationInputTokens"] += cache_write
                    if day in recent:
                        recent[day] += total
                    if day == today:
                        today_prompts += 1
                        today_sessions.add(session_key)
                        today_total_tokens += total
                        today_tokens_by_model[current_model] = (
                            today_tokens_by_model.get(current_model, 0) + total
                        )
        except OSError:
            continue

    stats.update(
        {
            "todayPrompts": today_prompts,
            "todaySessions": len(today_sessions),
            "todayTotalTokens": today_total_tokens,
            "todayTokensByModel": today_tokens_by_model,
            "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_dates],
            "totalPrompts": total_prompts,
            "totalSessions": len(total_sessions),
            "activeDays": len(active_days),
            "activeDates": sorted(active_days),
            "modelUsage": model_usage,
            "hasLocalStats": saw_any,
        }
    )
    return stats


def scan_cache_path() -> Path:
    return cache_path().parent / "codex-scan.json"


def cached_codex_scan(force: bool = False) -> dict:
    today = datetime.now().strftime("%Y-%m-%d")
    path = scan_cache_path()
    max_age = 0 if force else SCAN_LIMITS_REUSE_SECONDS
    if max_age > 0 and path.is_file():
        try:
            age = time.time() - path.stat().st_mtime
            if 0 <= age <= max_age:
                cached = json.loads(path.read_text(encoding="utf-8"))
                if (
                    isinstance(cached, dict)
                    and cached.get("schemaVersion") == 1
                    and cached.get("scanDate") == today
                    and isinstance(cached.get("stats"), dict)
                ):
                    return cached["stats"]
        except (OSError, json.JSONDecodeError, TypeError, ValueError):
            pass
    stats = scan_native_codex_sessions()
    try:
        atomic_write(
            path,
            json.dumps({"schemaVersion": 1, "scanDate": today, "stats": stats}, ensure_ascii=False) + "\n",
        )
    except OSError:
        pass
    return stats


def attach_codex_local_stats(rec: dict, force: bool = False) -> dict:
    out = dict(rec)
    try:
        stats = cached_codex_scan(force=force)
    except Exception:
        return out
    if not isinstance(stats, dict):
        return out
    for key in (
        "todayPrompts",
        "todaySessions",
        "todayTotalTokens",
        "todayTokensByModel",
        "recentDays",
        "totalPrompts",
        "totalSessions",
        "activeDays",
        "activeDates",
        "modelUsage",
        "hasLocalStats",
    ):
        if key in stats:
            out[key] = stats[key]
    return out


# --- Prices / API-equivalent cost --------------------------------------------


def load_prices() -> dict:
    path = prices_path()
    try:
        with path.open("rb") as fh:
            data = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    if not isinstance(data, dict):
        return {}
    models = data.get("models")
    if not isinstance(models, dict):
        return {}
    out = {}
    for name, row in models.items():
        if not isinstance(row, dict):
            continue
        try:
            inp = Decimal(str(row["input"]))
            cache = Decimal(str(row["cache"]))
            output = Decimal(str(row["output"]))
        except (KeyError, ArithmeticError, ValueError):
            continue
        key = str(name).strip().lower()
        if not key:
            continue
        entry = {"input": inp, "cache": cache, "output": output}
        if "cache_write" in row:
            try:
                entry["cache_write"] = Decimal(str(row["cache_write"]))
            except (ArithmeticError, ValueError):
                pass
        out[key] = entry
    return out


def lookup_price(model: str, prices: dict) -> dict | None:
    if not model or not prices:
        return None
    key = str(model).strip().lower()
    if key.startswith("openai/"):
        key = key[7:]
    return prices.get(key)


def _usd_tokens(n: int, per_million: Decimal) -> Decimal:
    if n <= 0:
        return Decimal("0")
    return (Decimal(n) * per_million) / MILLION


def api_equivalent_cost(model_usage, prices: dict) -> tuple[Decimal | None, list[str]]:
    """Priced buckets only. Unknown models are skipped, never guessed.

    Returns (amount, skipped_model_ids). None amount means cost unknown.
    """
    if not isinstance(model_usage, dict) or not model_usage:
        return None, []
    if not prices:
        return None, list(model_usage)
    total = Decimal("0")
    skipped: list[str] = []
    priced_any = False
    for model, bucket in model_usage.items():
        rate = lookup_price(str(model), prices)
        if rate is None or not isinstance(bucket, dict):
            skipped.append(str(model))
            continue
        priced_any = True
        inp = _tok_int(bucket.get("inputTokens"))
        out = _tok_int(bucket.get("outputTokens"))
        cache_read = _tok_int(bucket.get("cacheReadInputTokens"))
        cache_write = _tok_int(bucket.get("cacheCreationInputTokens"))
        total += _usd_tokens(inp, rate["input"])
        total += _usd_tokens(out, rate["output"])
        total += _usd_tokens(cache_read, rate["cache"])
        write_rate = rate.get("cache_write")
        if write_rate is not None:
            total += _usd_tokens(cache_write, write_rate)
    if not priced_any:
        return None, skipped
    return total, skipped


def format_usd(amount: Decimal) -> str:
    return f"${amount.quantize(USD_CENTS, rounding=ROUND_HALF_UP)}"


def export_quattro(pid: str, rec: dict) -> None:
    """Fail-soft upgrade copy. State dir, not omarchy share."""
    if not isinstance(rec, dict):
        return
    try:
        dest_dir = quattro_state_dir()
        dest_dir.mkdir(parents=True, exist_ok=True)
        limits = []
        for w in rec.get("windows") or []:
            if not isinstance(w, dict) or "used_pct" not in w:
                continue
            pct = as_pct(w.get("used_pct"))
            if pct is None:
                continue
            limits.append(
                {
                    "label": w.get("label") or w.get("kind") or "Limit",
                    "percent": float(pct) / 100.0,
                    "resetsAt": w.get("resets_at") or "",
                }
            )
        is_token_plan = pid == "token-plan"
        measured_at = rec.get("measured_at")
        has_measurement = isinstance(measured_at, str) and bool(measured_at)
        ready = (
            rec.get("status") == "ok"
            and not rec.get("last_error")
            and (not is_token_plan or (not rec.get("reason") and has_measurement))
        )
        error_text = str(
            rec.get("last_error")
            or rec.get("reason")
            or ("measurement_time_unknown" if is_token_plan and not has_measurement else "")
            or (rec.get("status") if rec.get("status") != "ok" else "")
        )
        updated_at = measured_at if is_token_plan and has_measurement else ("" if is_token_plan else iso_now())
        record = {
            "schemaVersion": 1,
            "id": pid,
            "name": rec.get("name") or pid,
            "updatedAt": updated_at,
            "ready": ready,
            "hasLocalStats": bool(rec.get("hasLocalStats")),
            "tierLabel": rec.get("plan") or "",
            "usageStatusText": "" if ready else error_text,
            "authHelpText": str(rec.get("reason") or ""),
            "limits": limits,
        }
        for key in (
            "todayPrompts",
            "todaySessions",
            "todayTotalTokens",
            "todayTokensByModel",
            "recentDays",
            "totalPrompts",
            "totalSessions",
            "activeDays",
            "activeDates",
            "modelUsage",
        ):
            if key in rec:
                record[key] = rec[key]
        atomic_write(dest_dir / f"{pid}.json", json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")
    except Exception:
        return


# --- TUI ---------------------------------------------------------------------


def format_token_count(n) -> str:
    try:
        n = int(n or 0)
    except (TypeError, ValueError):
        return "0"
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def parse_reset(ts) -> datetime | None:
    if not ts:
        return None
    text = str(ts).strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        iso = iso_from_unix(ts)
        if not iso:
            return None
        try:
            dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
        except ValueError:
            return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def format_reset_in(ts) -> str:
    dt = parse_reset(ts)
    if dt is None:
        return ""
    remaining = dt - datetime.now(timezone.utc)
    ms = remaining.total_seconds() * 1000
    if not (ms > 0):
        return "now"
    minutes = int(ms // 60000)
    hours = minutes // 60
    days = hours // 24
    if days > 0:
        return f"{days}d {hours % 24}h"
    if hours > 0:
        return f"{hours}h {minutes % 60}m"
    return f"{max(1, minutes)}m"


def tui_meter(pct, width: int = TUI_METER_WIDTH) -> str:
    value = as_pct(pct)
    if value is None:
        return "—"
    filled = round_half_up(value * width / 100.0)
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)


def token_meter(n: int, peak: int, width: int = TUI_METER_WIDTH) -> str:
    if peak <= 0:
        return "░" * width
    ratio = min(1.0, max(0.0, n / peak))
    filled = round_half_up(ratio * width)
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)


def _pct_label(pct) -> str:
    value = as_pct(pct)
    if value is None:
        return "—"
    if float(value) == int(value):
        return f"{int(value)}%"
    return f"{value}%"


def render_dashboard(cache: dict | None = None, selected: str | None = None, prices: dict | None = None) -> str:
    cache = cache if cache is not None else load_cache()
    pid = selected or pick_selected(cache)
    rec = cache.get("providers", {}).get(pid)
    if not isinstance(rec, dict):
        rec = empty_provider(pid if pid in PROVIDER_INDEX else "codex", "unknown", "no_cache")
    if pid == "codex" and not rec.get("hasLocalStats") and not rec.get("modelUsage"):
        rec = attach_codex_local_stats(rec)
    if prices is None:
        prices = load_prices()

    name = rec.get("name") or pid
    plan = rec.get("plan")
    header = f"{name}  ({plan})" if plan else str(name)
    lines = [header]
    status = rec.get("status")
    if (status and status != "ok") or rec.get("reason"):
        bit = str(status or "unknown")
        if rec.get("reason"):
            bit += f"  {rec['reason']}"
        lines.append(bit)
    lines.append("")

    chips = []
    for cid, cname, _logo in PROVIDERS:
        label = cname
        if cid == pid:
            chips.append(f"[{label}]")
        else:
            chips.append(f" {label} ")
    lines.append(" ".join(chips))
    lines.append("")

    lines.append("LIMITS")
    limit_rows = []
    for w in rec.get("windows") or []:
        if isinstance(w, dict):
            limit_rows.append(w)
    burst = rec.get("burst")
    if isinstance(burst, dict):
        limit_rows.append(burst)
    if not limit_rows:
        lines.append("  —")
    else:
        for w in limit_rows:
            label = str(w.get("label") or w.get("kind") or "Limit")
            pct = w.get("used_pct") if "used_pct" in w else None
            lines.append(f"{label:<28} {_pct_label(pct):>4}")
            lines.append(tui_meter(pct))
            reset = format_reset_in(w.get("resets_at"))
            if reset:
                prefix = "Resets in " if reset != "now" else "Resets "
                lines.append(prefix + reset)
            lines.append("")

    days = rec.get("recentDays") if isinstance(rec.get("recentDays"), list) else []
    models = rec.get("modelUsage") if isinstance(rec.get("modelUsage"), dict) else {}
    today = datetime.now().strftime("%Y-%m-%d")
    if days:
        lines.append("TOKENS BY DAY")
        peak = 0
        for d in days:
            if isinstance(d, dict):
                try:
                    peak = max(peak, int(d.get("messageCount") or 0))
                except (TypeError, ValueError):
                    pass
        for d in days:
            if not isinstance(d, dict):
                continue
            date = str(d.get("date") or "")
            try:
                count = int(d.get("messageCount") or 0)
            except (TypeError, ValueError):
                count = 0
            is_today = date == today
            try:
                label = "Today" if is_today else datetime.strptime(date, "%Y-%m-%d").strftime("%a")
            except ValueError:
                label = date or "?"
            mark = "*" if is_today else " "
            lines.append(f"{mark}{label:<6} {token_meter(count, peak)} {format_token_count(count):>7}")
        lines.append("")

    if models:
        lines.append("TOKENS BY MODEL")
        rows = []
        for mid, bucket in models.items():
            if not isinstance(bucket, dict):
                continue
            total = (
                _tok_int(bucket.get("inputTokens"))
                + _tok_int(bucket.get("outputTokens"))
                + _tok_int(bucket.get("cacheReadInputTokens"))
                + _tok_int(bucket.get("cacheCreationInputTokens"))
            )
            rows.append((str(mid), total, bucket))
        rows.sort(key=lambda r: r[1], reverse=True)
        peak_m = rows[0][1] if rows else 0
        for mid, total, _bucket in rows[:8]:
            lines.append(f"{mid:<28} {token_meter(total, peak_m, 16)} {format_token_count(total):>7}")
        lines.append("")

    lines.append("COST")
    amount, _skipped = api_equivalent_cost(models or None, prices)
    if amount is None:
        lines.append("cost unknown")
    else:
        lines.append(f"API would have cost {format_usd(amount)}")
    lines.append("OAuth incremental $0")
    lines.append("")
    lines.append("h/l or 1-5 switch · r refresh · q quit")
    return "\n".join(lines) + "\n"


def cmd_select(pid: str) -> int:
    if pid not in PROVIDER_INDEX:
        print(f"unknown provider: {pid}", file=sys.stderr)
        return 1
    write_selected(pid)
    cache = load_cache()
    cache["selected"] = pid
    path = cache_path()
    if path.exists():
        atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
    poke_waybar()
    print(pid)
    return 0


def _tui_loop(stdscr) -> int:
    import curses

    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.nodelay(False)
    ids = [pid for pid, _, _ in PROVIDERS]
    while True:
        text = render_dashboard()
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        for i, line in enumerate(text.splitlines()):
            if i >= maxy:
                break
            try:
                stdscr.addnstr(i, 0, line, max(0, maxx - 1))
            except curses.error:
                pass
        stdscr.refresh()
        try:
            ch = stdscr.get_wch()
        except curses.error:
            continue
        if ch in ("q", "Q"):
            return 0
        if ch in ("r", "R"):
            cmd_probe([], None)
            cache = load_cache()
            rec = cache.get("providers", {}).get("codex")
            if isinstance(rec, dict):
                cache["providers"]["codex"] = attach_codex_local_stats(rec, force=True)
                save_cache(cache)
            continue
        if ch in ("l", "L") or ch == curses.KEY_RIGHT:
            cmd_cycle("next")
            poke_waybar()
            continue
        if ch in ("h", "H") or ch == curses.KEY_LEFT:
            cmd_cycle("prev")
            poke_waybar()
            continue
        if isinstance(ch, str) and ch in "12345":
            cmd_select(ids[int(ch) - 1])
            continue
        if ch == curses.KEY_RESIZE:
            continue
    return 0


def cmd_tui(dump: bool = False) -> int:
    if dump or not sys.stdout.isatty():
        sys.stdout.write(render_dashboard())
        return 0
    try:
        import curses

        return curses.wrapper(_tui_loop)
    except Exception:
        sys.stdout.write(render_dashboard())
        return 0


PROBERS = {
    "codex": probe_codex,
    "token-plan": probe_token_plan,
    "grok": probe_grok,
    "kimi": probe_kimi,
    "cursor": probe_cursor,
}


def probe_one(pid: str, fixture: str | None = None) -> dict:
    if pid == "codex":
        return probe_codex(fixture)
    if pid == "cursor":
        return probe_cursor(fixture)
    fn = PROBERS.get(pid)
    if not fn:
        raise SystemExit(f"unknown provider: {pid}")
    return fn()


def summarize(rec: dict) -> str:
    bits = [rec.get("id", "?"), rec.get("status", "?")]
    if rec.get("reason"):
        bits.append(str(rec["reason"]))
    for w in rec.get("windows") or []:
        if isinstance(w, dict) and "used_pct" in w:
            bits.append(f"{w.get('kind')}={w['used_pct']}")
    return " ".join(bits)


def cmd_probe(ids: list[str], fixture: str | None) -> int:
    cache = load_cache()
    targets = ids or [pid for pid, _, _ in PROVIDERS]
    for pid in targets:
        rec = probe_one(pid, fixture if pid in ("codex", "cursor") else None)
        upsert(cache, rec)
        print(summarize(rec))
    cache["selected"] = pick_selected(cache)
    write_selected(cache["selected"])
    save_cache(cache)
    for pid, rec in (cache.get("providers") or {}).items():
        if isinstance(rec, dict):
            export_quattro(pid, rec)
    return 0


# --- Renderer ----------------------------------------------------------------


def round_half_up(n: float) -> int:
    return int(n + 0.5) if n >= 0 else int(n - 0.5)


def meter(pct) -> str:
    """Gray track, white fill — no block-grid characters."""
    value = as_pct(pct)
    if value is None:
        return "—"
    filled = round_half_up(value * METER_WIDTH / 100.0)
    filled = max(0, min(METER_WIDTH, filled))
    rest = METER_WIDTH - filled
    inner = ""
    if filled:
        inner += f"<span bgcolor='{METER_FILL}'>{NBSP * filled}</span>"
    if rest:
        inner += NBSP * rest
    return f"<span bgcolor='{METER_TRACK}'>{inner}</span>"


def window_by_kind(rec: dict, kind: str) -> dict | None:
    for w in rec.get("windows") or []:
        if isinstance(w, dict) and w.get("kind") == kind:
            return w
    return None


def extra_window(rec: dict) -> dict:
    special = window_by_kind(rec, "special")
    if special is not None:
        return special
    credits = window_by_kind(rec, "credits")
    if credits is not None:
        return credits
    return window_by_kind(rec, "session") or {}


def pango_escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def cache_age_sec(cache: dict) -> float | None:
    stamp = cache.get("updated_at")
    if not stamp:
        return None
    try:
        dt = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return max(0.0, time.time() - dt.timestamp())


def _timestamp_age_sec(stamp) -> float | None:
    parsed = parse_reset(stamp)
    if parsed is None:
        return None
    return max(0.0, time.time() - parsed.timestamp())


def _token_plan_waybar_payload(rec: dict, logo: str, ident_id: str) -> dict:
    weekly = window_by_kind(rec, "weekly") or {}
    hottest = window_by_kind(rec, "special") or {}
    mark = f"{logo} @{ident_id}" if ident_id else logo
    text = f"{pango_escape(mark)} {meter(weekly.get('used_pct'))} {meter(hottest.get('used_pct'))}"
    classes = [str(rec.get("status") or "unknown")]
    account_usage = rec.get("account_usage")
    account_usage = account_usage if isinstance(account_usage, list) else []
    ages = [
        _timestamp_age_sec(item.get("fetched_at"))
        for item in account_usage
        if isinstance(item, dict)
    ]
    if any(age is not None and age > STALE_AFTER_SEC for age in ages):
        classes.append("stale")
    hottest_pct = as_pct(hottest.get("used_pct"))
    if hottest_pct is not None and hottest_pct >= 95:
        classes.append("critical")
    elif hottest_pct is not None and hottest_pct >= 80:
        classes.append("warn")

    lines = [str(rec.get("name") or "Token Plan")]
    if ident_id:
        lines.append(f"active route: {ident_id} · routing only; not mapped to a snapshot")
    if rec.get("reason"):
        lines.append(str(rec["reason"]))
    if rec.get("last_error"):
        lines.append("last error: " + str(rec["last_error"]))
    lines.append(f"{weekly.get('label') or 'Account average'}: {_pct_label(weekly.get('used_pct'))}")

    hottest_index = None
    if hottest_pct is not None:
        for index, item in enumerate(account_usage, 1):
            if isinstance(item, dict) and as_pct(item.get("used_pct")) == hottest_pct:
                hottest_index = index
                break
    hottest_line = f"{hottest.get('label') or 'Hottest account'}: {_pct_label(hottest.get('used_pct'))}"
    if hottest_index is not None:
        hottest_line += f" · snapshot {hottest_index}"
    lines.append(hottest_line)

    for index, item in enumerate(account_usage, 1):
        if not isinstance(item, dict):
            continue
        fetched_at = item.get("fetched_at")
        fetched_age = _timestamp_age_sec(fetched_at)
        fetched_text = str(fetched_at) if fetched_age is not None else "unknown"
        if fetched_age is not None:
            fetched_text += f" ({int(fetched_age)}s ago)"
        bit = f"snapshot {index}: {_pct_label(item.get('used_pct'))} · fetched: {fetched_text}"
        if item.get("resets_at"):
            bit += f" · reset {item['resets_at']}"
        lines.append(bit)

    snapshot = rec.get("snapshot")
    if isinstance(snapshot, dict):
        lines.append(
            "snapshot coverage: "
            f"{snapshot.get('reports', 0)} reports · "
            f"{snapshot.get('accounts_without_usage', 0)} without usage · "
            f"{snapshot.get('disabled_credentials', 0)} disabled"
        )
    capacity = rec.get("capacity")
    if isinstance(capacity, dict) and capacity:
        lines.append(
            "capacity: "
            f"{capacity.get('used_accounts', '—')} / {capacity.get('accounts', '—')} "
            "account-equivalents used · "
            f"{capacity.get('remaining_accounts', '—')} remaining"
        )
    return {
        "text": text,
        "tooltip": pango_escape("\n".join(lines)),
        "class": " ".join(classes),
        "alt": "token-plan",
    }


def cmd_waybar() -> int:
    cache = load_cache()
    pid = pick_selected(cache)
    rec = cache.get("providers", {}).get(pid)
    if not isinstance(rec, dict):
        rec = empty_provider(pid if pid in PROVIDER_INDEX else "codex", "unknown", "no_cache")
        rec["logo"] = PROVIDER_INDEX.get(pid, ("?", "?"))[1] if pid in PROVIDER_INDEX else "?"
    if pid == "token-plan":
        rec = attach_token_plan_identity(dict(rec))
    elif pid == "cursor":
        rec = attach_cursor_identity(dict(rec))
    logo = str(rec.get("logo") or PROVIDER_INDEX.get(pid, ("?", "?"))[1])
    ident = rec.get("identity") if isinstance(rec.get("identity"), dict) else {}
    ident_id = str(ident.get("id") or ident.get("label") or "").strip()
    if pid == "token-plan":
        payload = _token_plan_waybar_payload(rec, logo, ident_id)
        sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
        return 0
    mark = f"{logo} {ident_id}" if ident_id else logo
    weekly = window_by_kind(rec, "weekly") or {}
    extra = extra_window(rec)
    extra_bits = extra.get("extra") if isinstance(extra.get("extra"), dict) else {}
    if extra.get("kind") == "credits" and extra_bits.get("remaining_usd") is not None:
        usd = float(extra_bits["remaining_usd"])
        extra_txt = f"${usd:.0f}" if usd >= 10 else f"${usd:.2f}"
    else:
        extra_txt = meter(extra.get("used_pct"))
    text = f"{pango_escape(mark)} {meter(weekly.get('used_pct'))} {extra_txt}"
    status = rec.get("status") or "unknown"
    classes = [status]
    age = cache_age_sec(cache)
    if age is not None and age > STALE_AFTER_SEC:
        classes.append("stale")
    pcts = [as_pct(weekly.get("used_pct")), as_pct(extra.get("used_pct"))]
    known = [p for p in pcts if p is not None]
    if known and max(known) >= 95:
        classes.append("critical")
    elif known and max(known) >= 80:
        classes.append("warn")
    lines = [f"{rec.get('name') or pid}" + (f" ({rec['plan']})" if rec.get("plan") else "")]
    if ident_id:
        title = str(ident.get("title") or ident_id)
        lines.append(f"identity: {ident_id}" + (f" · {title}" if title and title != ident_id else ""))
    if rec.get("reason"):
        lines.append(str(rec["reason"]))
    if rec.get("last_error"):
        lines.append("last error: " + str(rec["last_error"]))
    for w in rec.get("windows") or []:
        if not isinstance(w, dict):
            continue
        label = w.get("label") or w.get("kind")
        if "used_pct" in w:
            bit = f"{label}: {w['used_pct']}%"
        else:
            bit = f"{label}: —"
        extra_bits = w.get("extra") if isinstance(w.get("extra"), dict) else {}
        if extra_bits.get("remaining_usd") is not None:
            bit += f"  ${float(extra_bits['remaining_usd']):.2f} left"
        if w.get("resets_at"):
            bit += f"  reset {w['resets_at']}"
        lines.append(bit)
    burst = rec.get("burst")
    if isinstance(burst, dict) and "used_pct" in burst:
        bit = f"{burst.get('label') or 'burst'}: {burst['used_pct']}%"
        if burst.get("resets_at"):
            bit += f"  reset {burst['resets_at']}"
        lines.append(bit)
    if age is not None:
        lines.append(f"cache {int(age)}s ago")
    payload = {
        "text": text,
        "tooltip": pango_escape("\n".join(lines)),
        "class": " ".join(classes),
        "alt": pid,
    }
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
    return 0


def cmd_cycle(direction: str) -> int:
    cache = load_cache()
    present = [pid for pid, _, _ in PROVIDERS if pid in cache.get("providers", {})]
    if not present:
        print("no providers in cache")
        return 1
    current = pick_selected(cache)
    if current not in present:
        nxt = present[0]
    else:
        idx = present.index(current)
        delta = -1 if direction == "prev" else 1
        nxt = present[(idx + delta) % len(present)]
    cache["selected"] = nxt
    write_selected(nxt)
    # Persist selection without bumping probe freshness.
    path = cache_path()
    if path.exists():
        atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
    print(nxt)
    return 0


def blank_usage_windows(rec: dict) -> dict:
    """Drop used_pct after an identity flip so the chip does not keep the other key's meters."""
    rec = dict(rec)
    rec["windows"] = [
        {k: v for k, v in w.items() if k != "used_pct"}
        for w in (rec.get("windows") or [])
        if isinstance(w, dict)
    ]
    burst = rec.get("burst")
    if isinstance(burst, dict) and "used_pct" in burst:
        burst = dict(burst)
        burst.pop("used_pct", None)
        rec["burst"] = burst
    rec["status"] = "unknown"
    rec["reason"] = "switched"
    rec.pop("last_error", None)
    return rec


def _identity_helper_failed(pid: str, proc: subprocess.CompletedProcess[str] | None, unavailable: bool) -> int:
    if unavailable:
        print(f"{pid} swap-failed: helper unavailable", file=sys.stderr)
        return 1
    assert proc is not None
    print(f"{pid} swap-failed: exit {proc.returncode}", file=sys.stderr)
    return proc.returncode


def cmd_identity(direction: str) -> int:
    """Cycle identities for the selected provider via its local swap helper."""
    cache = load_cache()
    selected = pick_selected(cache)
    action = "toggle" if direction in ("next", "prev") else direction
    if selected == "token-plan":
        swap = os.environ.get("AI_USAGE_TOKEN_PLAN_SWAP") or which("token-plan-swap")
        if swap is None:
            print("token-plan: token-plan-swap not found", file=sys.stderr)
            return 1
        swap_env = child_env()
        conf = token_plan_conf()
        if conf.name == "alibaba-token-plan":
            swap_env["XDG_CONFIG_HOME"] = str(conf.parent)
        try:
            proc = subprocess.run(
                [swap, action],
                env=swap_env,
                check=False,
                capture_output=True,
                text=True,
                timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired):
            return _identity_helper_failed("token-plan", None, True)
        if proc.returncode != 0:
            return _identity_helper_failed("token-plan", proc, False)
        rec = cache.get("providers", {}).get("token-plan")
        if not isinstance(rec, dict):
            rec = _empty_token_plan("no_cache")
        rec = dict(rec)
        rec["id"] = "token-plan"
        rec = attach_token_plan_identity(rec)
        cache.setdefault("providers", {})["token-plan"] = rec
        path = cache_path()
        if path.exists():
            atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
        print((rec.get("identity") or {}).get("id") or "?")
        return 0
    if selected == "cursor":
        swap = os.environ.get("AI_USAGE_CURSOR_OAUTH_SWAP") or which("cursor-oauth-swap")
        if swap is None:
            print("cursor: cursor-oauth-swap not found", file=sys.stderr)
            return 1
        swap_env = child_env()
        swap_env["CURSOR_OAUTH_HOME"] = str(cursor_oauth_conf())
        swap_env["CURSOR_AUTH_FILE"] = str(_cursor_auth_path())
        try:
            proc = subprocess.run(
                [swap, action],
                env=swap_env,
                check=False,
                capture_output=True,
                text=True,
                timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired):
            return _identity_helper_failed("cursor", None, True)
        if proc.returncode != 0:
            return _identity_helper_failed("cursor", proc, False)
        rec = cache.get("providers", {}).get("cursor")
        if not isinstance(rec, dict):
            rec = empty_provider("cursor", "unknown", "no_cache")
        rec = dict(rec)
        rec["id"] = "cursor"
        rec = attach_cursor_identity(blank_usage_windows(rec))
        cache.setdefault("providers", {})["cursor"] = rec
        path = cache_path()
        if path.exists():
            atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
        print((rec.get("identity") or {}).get("id") or "?")
        return 0
    print(f"{selected}: no identity cycle configured")
    return 0


def cmd_validate() -> int:
    path = cache_path()
    if not path.exists():
        print("INVALID: no cache")
        return 1
    mode = stat.S_IMODE(path.stat().st_mode)
    cache = load_cache()
    ok = True
    notes = [f"cache: {path}", f"mode: {mode:o}"]
    if mode != 0o600:
        ok = False
        notes.append("mode must be 0600")
    if cache.get("version") != VERSION:
        ok = False
        notes.append(f"version {cache.get('version')} != {VERSION}")
    selected = pick_selected(cache)
    notes.append(f"selected: {selected}")
    providers = cache.get("providers") or {}
    if selected not in providers:
        ok = False
        notes.append("selected provider missing")
    for pid, rec in providers.items():
        if not isinstance(rec, dict):
            ok = False
            notes.append(f"{pid}: not an object")
            continue
        status = rec.get("status")
        if status not in ("ok", "unauth", "unknown"):
            ok = False
            notes.append(f"{pid}: bad status {status!r}")
        kinds = []
        for w in rec.get("windows") or []:
            if not isinstance(w, dict):
                ok = False
                continue
            kinds.append(w.get("kind"))
            if "used_pct" in w and as_pct(w.get("used_pct")) is None:
                ok = False
                notes.append(f"{pid}: invented/non-numeric used_pct")
        line = f"{pid}: {status}"
        if rec.get("reason"):
            line += f" {rec['reason']}"
        for w in rec.get("windows") or []:
            if isinstance(w, dict) and "used_pct" in w:
                line += f" {w.get('kind')}={w['used_pct']}"
        notes.append(line)
    print("\n".join(notes))
    print("VALID" if ok else "INVALID")
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ai-usage", description="AI CLI usage chip for Waybar")
    sub = p.add_subparsers(dest="cmd", required=True)
    probe = sub.add_parser("probe", help="fetch provider windows into cache")
    probe.add_argument("id", nargs="?", help="provider id (default: all)")
    probe.add_argument("--fixture", help="Codex or Cursor RPC snapshot JSON (no network)")
    sub.add_parser("waybar", help="print Waybar JSON from cache only")
    cyc = sub.add_parser("cycle", help="rotate selected provider")
    cyc.add_argument("direction", nargs="?", default="next", choices=("next", "prev"))
    ident = sub.add_parser("identity", help="rotate identity inside the selected provider")
    ident.add_argument("direction", nargs="?", default="next", choices=("next", "prev"))
    sub.add_parser("validate", help="schema-check cache")
    sub.add_parser("refresh", help="probe all providers")
    tui = sub.add_parser("tui", help="Quattro-like usage dashboard")
    tui.add_argument("--dump", action="store_true", help="print dashboard and exit")
    sel = sub.add_parser("select", help="set selected provider")
    sel.add_argument("id")
    return p


def main(argv: list[str] | None = None) -> int:
    ensure_path()
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.cmd == "probe":
        ids = [args.id] if args.id else []
        return cmd_probe(ids, args.fixture)
    if args.cmd == "refresh":
        return cmd_probe([], None)
    if args.cmd == "waybar":
        return cmd_waybar()
    if args.cmd == "cycle":
        return cmd_cycle(args.direction)
    if args.cmd == "identity":
        return cmd_identity(args.direction)
    if args.cmd == "validate":
        return cmd_validate()
    if args.cmd == "tui":
        return cmd_tui(dump=args.dump)
    if args.cmd == "select":
        return cmd_select(args.id)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
