# --- TUI ---------------------------------------------------------------------


def parse_reset(ts) -> datetime | None:
    if not ts:
        return None
    text = str(ts).strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        iso = iso_from_unix(ts)
        if not iso:
            return None
        try:
            dt = datetime.fromisoformat(iso)
        except ValueError:
            return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=UTC)
    return dt


def format_reset_in(ts) -> str:
    """Countdown to a reset: `2d 14h`, `3d`, `2h 13m`, `45m`, or `now`."""
    dt = parse_reset(ts)
    if dt is None:
        return ""
    remaining = dt - datetime.now(UTC)
    ms = remaining.total_seconds() * 1000
    if not (ms > 0):
        return "now"
    minutes = int(ms // 60000)
    hours = minutes // 60
    days = hours // 24
    if days > 0:
        return f"{days}d {hours % 24}h" if hours % 24 else f"{days}d"
    if hours > 0:
        return f"{hours}h {minutes % 60}m" if minutes % 60 else f"{hours}h"
    return f"{max(1, minutes)}m"


def tui_meter(pct, width: int = TUI_METER_WIDTH) -> str:
    value = as_pct(pct)
    if value is None:
        return "—"
    filled = round_half_up(value * width / 100.0)
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)


def _pct_label(pct) -> str:
    """Whole percent: 24.83 -> 25%. Never a false 0% or 100% at the edges."""
    value = as_pct(pct)
    if value is None:
        return "—"
    if 0 < value < 1:
        return "<1%"
    if 99 < value < 100:
        return "99%"
    return f"{round_half_up(value)}%"


def render_dashboard(cache: dict | None = None, selected: str | None = None) -> str:
    cache = cache if cache is not None else load_cache()
    pid = selected or pick_selected(cache)
    rec = cache.get("providers", {}).get(pid)
    if not isinstance(rec, dict):
        rec = empty_provider(pid if pid in PROVIDER_INDEX else "codex", "unknown", "no_cache")

    name = rec.get("name") or pid
    plan = rec.get("plan")
    header = f"{name}  ({plan})" if plan else str(name)
    lines = [header]
    status = rec.get("status")
    if (status and status != "ok") or rec.get("reason"):
        bit = str(status or "unknown")
        if rec.get("reason"):
            bit += f"  {rec['reason']}"
        lines.append(bit)
    lines.append("")

    chips = []
    all_providers = cache.get("providers", {})
    for cid, cname, _logo in active_providers():
        if not _provider_usable(all_providers.get(cid)):
            continue
        label = cname
        if cid == pid:
            chips.append(f"[{label}]")
        else:
            chips.append(f" {label} ")
    lines.append(" ".join(chips))
    lines.append("")

    lines.append("LIMITS")
    limit_rows = []
    for w in rec.get("windows") or []:
        if isinstance(w, dict):
            limit_rows.append(w)
    burst = rec.get("burst")
    if isinstance(burst, dict):
        limit_rows.append(burst)
    if not limit_rows:
        lines.append("  —")
    else:
        for w in limit_rows:
            label = str(w.get("label") or w.get("kind") or "Limit")
            pct = w.get("used_pct") if "used_pct" in w else None
            extra_bits = w.get("extra") if isinstance(w.get("extra"), dict) else {}
            balance = _token_plan_number(extra_bits.get("remaining_credits")) if pct is None else None
            if balance is not None:
                # A balance has no ceiling, so the number is the meter:
                # Command Code's monthly credits refill on a billing date
                # OMP does not report.
                lines.append(f"{label:<28} {_credits_label(balance):>4} cr")
                lines.append(
                    "monthly + purchased + free credits · refill date not reported"
                    if rec.get("id") == "commandcode"
                    else "prepaid credits · no reset window"
                )
                lines.append("")
                continue
            wallet = _token_plan_number(extra_bits.get("remaining_usd")) if pct is None else None
            if wallet is not None:
                lines.append(f"{label:<28} ${float(extra_bits['remaining_usd']):.2f}")
                if rec.get("id") == "amr":
                    lines.append("wallet balance · spent after the Coding Plan windows")
                lines.append("")
                continue
            spent = _token_plan_number(extra_bits.get("spent_usd")) if pct is None else None
            if spent is not None:
                lines.append(f"{label:<28} {_usd_label(float(spent))}")
                reset = format_reset_in(w.get("resets_at"))
                if reset:
                    lines.append(("Resets in " if reset != "now" else "Resets ") + reset)
                lines.append("")
                continue
            lines.append(f"{label:<28} {_pct_label(pct):>4}")
            lines.append(tui_meter(pct))
            reset = format_reset_in(w.get("resets_at"))
            if reset:
                prefix = "Resets in " if reset != "now" else "Resets "
                lines.append(prefix + reset)
            lines.append("")

    tokens = rec.get("tokens") if isinstance(rec.get("tokens"), dict) else {}
    tokens_left = _token_plan_number(tokens.get("remaining"))
    tokens_total = _token_plan_number(tokens.get("total"))
    unmetered_keys = _token_plan_number(tokens.get("unmetered_keys")) or 0
    if tokens_left is not None:
        lines.append(f"{'Tokens left':<28} {_tokens_label(tokens_left)} of {_tokens_label(tokens_total)}")
        lines.append("one-time grant · tokens OMP spent, not usage elsewhere")
        lines.append("")
    elif unmetered_keys and tokens_total is not None:
        lines.append(f"{'Grant capacity':<28} {_tokens_label(tokens_total)} across {tokens.get('key_count')} keys")
        lines.append(f"{unmetered_keys} key(s) not in OMP; usage unknown")
        lines.append("")
    spend_lines = mistral_spend_lines(rec)
    if spend_lines:
        lines.extend(spend_lines)
        lines.append("")
    lines.append("h/l or 1-9 switch · r refresh · q quit")
    return "\n".join(lines) + "\n"


def cmd_select(pid: str) -> int:
    if pid not in PROVIDER_INDEX:
        print(f"unknown provider: {pid}", file=sys.stderr)
        return 1
    write_selected(pid)
    cache = load_cache()
    cache["selected"] = pid
    path = cache_path()
    if path.exists():
        atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
    poke_waybar()
    print(pid)
    return 0


def _tui_loop(stdscr) -> int:
    import curses

    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.nodelay(False)
    ids = active_provider_ids()
    while True:
        text = render_dashboard()
        stdscr.erase()
        maxy, maxx = stdscr.getmaxyx()
        for i, line in enumerate(text.splitlines()):
            if i >= maxy:
                break
            try:
                stdscr.addnstr(i, 0, line, max(0, maxx - 1))
            except curses.error:
                pass
        stdscr.refresh()
        try:
            ch = stdscr.get_wch()
        except curses.error:
            continue
        if ch in ("q", "Q"):
            return 0
        if ch in ("r", "R"):
            cmd_probe([])
            continue
        if ch in ("l", "L") or ch == curses.KEY_RIGHT:
            cmd_cycle("next")
            poke_waybar()
            continue
        if ch in ("h", "H") or ch == curses.KEY_LEFT:
            cmd_cycle("prev")
            poke_waybar()
            continue
        # A roster shorter than 9 providers has no key for the higher digits.
        if isinstance(ch, str) and ch in "123456789" and int(ch) <= len(ids):
            cmd_select(ids[int(ch) - 1])
            continue
        if ch == curses.KEY_RESIZE:
            continue
    return 0


def cmd_tui(dump: bool = False) -> int:
    if dump or not sys.stdout.isatty():
        sys.stdout.write(render_dashboard())
        return 0
    try:
        import curses

        return curses.wrapper(_tui_loop)
    except Exception:  # noqa: BLE001 - any curses failure falls back to the dump
        sys.stdout.write(render_dashboard())
        return 0


PROBERS = {
    "codex": probe_codex,
    "grok": probe_grok,
    "kimi": probe_kimi,
    "cursor": probe_cursor,
    "devin": probe_devin,
    "devin2": probe_devin2,
    "opencode-go": probe_opencode_go,
    "zai": probe_zai,
    "minimax": probe_minimax,
    "google": probe_google,
    "anthropic": probe_anthropic,
    "commandcode": probe_commandcode,
    "inception": probe_inception,
    "mistral": probe_mistral,
    "amr": probe_amr,
}


def probe_one(pid: str) -> dict:
    fn = PROBERS.get(pid)
    if not fn:
        raise SystemExit(f"unknown provider: {pid}")
    return fn()


def summarize(rec: dict) -> str:
    bits = [rec.get("id", "?"), rec.get("status", "?")]
    if rec.get("reason"):
        bits.append(str(rec["reason"]))
    for w in rec.get("windows") or []:
        if isinstance(w, dict) and "used_pct" in w:
            bits.append(f"{w.get('kind')}={w['used_pct']}")
        if isinstance(w, dict):
            extra_bits = w.get("extra") if isinstance(w.get("extra"), dict) else {}
            if _token_plan_number(extra_bits.get("remaining_usd")) is not None:
                bits.append(f"wallet=${float(extra_bits['remaining_usd']):.2f}")
            if _token_plan_number(extra_bits.get("spent_usd")) is not None:
                bits.append(f"spent=${float(extra_bits['spent_usd']):.2f}")
    credits = rec.get("credits") if isinstance(rec.get("credits"), dict) else {}
    remaining = _token_plan_number(credits.get("remaining"))
    if remaining is not None:
        bits.append(f"credits={_credits_label(remaining)}")
    tokens = rec.get("tokens") if isinstance(rec.get("tokens"), dict) else {}
    if _token_plan_number(tokens.get("remaining")) is not None:
        bits.append(f"tokens_left={_tokens_label(tokens['remaining'])}")
    elif _token_plan_number(tokens.get("unmetered_keys")):
        bits.append(f"keys={tokens.get('key_count')}")
    return " ".join(bits)


def cmd_probe(ids: list[str]) -> int:
    cache = load_cache()
    targets = ids or active_provider_ids()
    for pid in targets:
        rec = probe_one(pid)
        upsert(cache, rec)
        print(summarize(rec))
    cache["selected"] = pick_selected(cache)
    write_selected(cache["selected"])
    save_cache(cache)
    return 0


def cmd_login(pid: str) -> int:
    """Sign a provider account in; only OpenDesign (AMR) supports it so far."""
    override = os.environ.get("AI_USAGE_VELA_BIN")
    vela = override if override else which("vela")
    if not vela or not Path(vela).is_file() or not os.access(vela, os.X_OK):
        print(
            "ai-usage: vela CLI not found; install it with: npm install -g @powerformer/vela-cli",
            file=sys.stderr,
        )
        return 1
    root = amr_slots_root()
    existing = [slot for slot, _dir in _amr_slot_dirs(root)]
    slot = (max(existing) if existing else 0) + 1
    slot_dir = root / str(slot)
    ensure_dir(root, 0o700)
    ensure_dir(slot_dir, 0o700)
    env = child_env()
    env["AMR_HOME"] = str(slot_dir)
    env["VELA_PROFILE"] = "prod"
    for key in ("VELA_CONTROL_KEY", "VELA_RUNTIME_KEY", "OPEN_DESIGN_AMR_PROFILE"):
        env.pop(key, None)
    try:
        result = subprocess.run([vela, "login"], env=env)
    except KeyboardInterrupt:
        shutil.rmtree(slot_dir, ignore_errors=True)
        return 130
    except OSError:
        result = None
    if result is None or result.returncode != 0 or _amr_slot_config(slot_dir) is None:
        shutil.rmtree(slot_dir, ignore_errors=True)
        print("ai-usage: OpenDesign sign-in did not complete", file=sys.stderr)
        return 1
    try:
        os.chmod(slot_dir / "config.json", 0o600)
    except OSError:
        pass
    prod = _amr_slot_config(slot_dir) or {}
    user = prod.get("user") if isinstance(prod.get("user"), dict) else {}
    new_user_id = user.get("id")
    for other_slot, other_dir in _amr_slot_dirs(root):
        if other_slot == slot or not new_user_id:
            continue
        other_prod = _amr_slot_config(other_dir)
        if other_prod is None:
            continue
        other_user = other_prod.get("user") if isinstance(other_prod.get("user"), dict) else {}
        if other_user.get("id") == new_user_id:
            shutil.rmtree(other_dir)
            print(f"ai-usage: replaced slot {other_slot} (same OpenDesign account)")
    email = user.get("email")
    who = email if isinstance(email, str) and email.strip() else "account"
    print(f"ai-usage: OpenDesign {who} signed in as slot {slot}")
    return cmd_probe(["amr"])


# --- Renderer ----------------------------------------------------------------


def round_half_up(n: float) -> int:
    return int(n + 0.5) if n >= 0 else int(n - 0.5)


def meter(pct, width: int = METER_WIDTH) -> str:
    """Gray track, white fill — no block-grid characters."""
    value = as_pct(pct)
    if value is None:
        return "—"
    filled = round_half_up(value * width / 100.0)
    filled = max(0, min(width, filled))
    rest = width - filled
    inner = ""
    if filled:
        inner += f"<span bgcolor='{METER_FILL}'>{NBSP * filled}</span>"
    if rest:
        inner += NBSP * rest
    return f"<span bgcolor='{METER_TRACK}'>{inner}</span>"


def tooltip_meter(pct, width: int = TOOLTIP_METER_WIDTH) -> str:
    """Thin tracks rather than full-line backgrounds in multiline tooltips."""
    value = as_pct(pct)
    if value is None:
        return "—".ljust(width)
    filled = max(0, min(width, round_half_up(value * width / 100.0)))
    track = "━"
    return track * filled + f"<span fgalpha='30%'>{track * (width - filled)}</span>"


def window_by_kind(rec: dict, kind: str) -> dict | None:
    for w in rec.get("windows") or []:
        if isinstance(w, dict) and w.get("kind") == kind:
            return w
    return None


def extra_window(rec: dict) -> dict:
    special = window_by_kind(rec, "special")
    if special is not None:
        return special
    credits = window_by_kind(rec, "credits")
    if credits is not None:
        return credits
    return window_by_kind(rec, "session") or {}


def pango_escape(text: str) -> str:
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def cache_age_sec(cache: dict) -> float | None:
    stamp = cache.get("updated_at")
    if not stamp:
        return None
    try:
        dt = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except ValueError:
        return None
    return max(0.0, time.time() - dt.timestamp())


def _timestamp_age_sec(stamp) -> float | None:
    parsed = parse_reset(stamp)
    if parsed is None:
        return None
    return max(0.0, time.time() - parsed.timestamp())


def age_text(seconds) -> str:
    """Coarse age: `just now`, `4m ago`, `3h ago`, `2d ago`."""
    if seconds is None:
        return "unknown"
    s = int(seconds)
    if s < 60:
        return "just now"
    if s < 3600:
        return f"{s // 60}m ago"
    if s < 86400:
        return f"{s // 3600}h ago"
    return f"{s // 86400}d ago"


def reset_phrase(ts) -> str:
    reset = format_reset_in(ts)
    if not reset:
        return ""
    return "resets now" if reset == "now" else f"resets in {reset}"


def muted(text: str) -> str:
    """Secondary tooltip text, dimmed so the meters carry the eye."""
    return f"<span fgalpha='80%'>{pango_escape(text)}</span>"


def display_label(label, accounts: int) -> str:
    """Drop a redundant count, but keep smaller per-window coverage visible."""
    text = str(label or "").strip()
    text = text.removeprefix(f"{accounts}-account ")
    return text[:1].upper() + text[1:] if text else "Limit"


def report_count(rec: dict) -> int:
    snapshot = rec.get("snapshot") if isinstance(rec.get("snapshot"), dict) else {}
    reports = snapshot.get("reports")
    return reports if isinstance(reports, int) and not isinstance(reports, bool) else 0


def tooltip_header(rec: dict, fallback: str, notes: list[str]) -> list[str]:
    """Bold provider name, dimmed context notes, then the bounded reason/error."""
    title = f"<b>{pango_escape(str(rec.get('name') or fallback))}</b>"
    if rec.get("plan"):
        title += "  " + muted(str(rec["plan"]))
    lines = [title]
    lines.extend(muted(note) for note in notes)
    if rec.get("reason"):
        lines.append(muted(str(rec["reason"])))
    if rec.get("last_error"):
        lines.append("last error: " + pango_escape(str(rec["last_error"])))
    return lines


def window_lines(windows: list[dict], accounts: int) -> list[str]:
    """Aligned `Label  [meter]  25%  resets in 2d 14h` rows."""
    labelled = [(display_label(w.get("label") or w.get("kind"), accounts), w) for w in windows]
    width = max((len(label) for label, _ in labelled), default=0)
    out = []
    for label, w in labelled:
        pct = w.get("used_pct")
        extra_bits = w.get("extra") if isinstance(w.get("extra"), dict) else {}
        # A counter with no ceiling has no meter to fill: show the number.
        balance = _token_plan_number(extra_bits.get("remaining_credits")) if pct is None else None
        if balance is not None:
            amount = pango_escape(_credits_label(balance))
            out.append(f"{pango_escape(label.ljust(width))}  {amount} credits left")
            continue
        wallet = _token_plan_number(extra_bits.get("remaining_usd")) if pct is None else None
        if wallet is not None:
            out.append(f"{pango_escape(label.ljust(width))}  ${float(extra_bits['remaining_usd']):.2f} left")
            continue
        spent = _token_plan_number(extra_bits.get("spent_usd")) if pct is None else None
        if spent is not None:
            reset = reset_phrase(w.get("resets_at"))
            line = f"{pango_escape(label.ljust(width))}  {_usd_label(float(spent))} spent"
            out.append(line + ("  " + muted(reset) if reset else ""))
            continue
        bar = tooltip_meter(pct)
        line = f"{pango_escape(label.ljust(width))}  {bar} {pango_escape(_pct_label(pct).rjust(4))}"
        tail = []
        if extra_bits.get("remaining_usd") is not None:
            tail.append(f"${float(extra_bits['remaining_usd']):.2f} left")
        if extra_bits.get("spent_usd") is not None and extra_bits.get("budget_usd") is not None:
            tail.append(f"{_usd_label(float(extra_bits['spent_usd']))} of {_usd_label(float(extra_bits['budget_usd']))}")
        reset = reset_phrase(w.get("resets_at"))
        if reset:
            tail.append(reset)
        if tail:
            line += "  " + muted(" · ".join(tail))
        out.append(line)
    return out


def usage_row_line(index: int, row: dict) -> str:
    """One stored snapshot: meter, percent, what binds it, when it resets.

    The fetch time shows only once a row has gone stale; fresh rows need no
    timestamp. OMP exposes no account identity, so rows are numbered; AMR rows
    carry their slot number instead.
    """
    number = row.get("slot")
    if not (isinstance(number, int) and not isinstance(number, bool)):
        number = index
    pct = row.get("used_pct")
    bar = tooltip_meter(pct, METER_WIDTH)
    line = f"{number:>2}  {bar} {pango_escape(_pct_label(pct).rjust(4))}"
    detail = []
    error = row.get("error")
    if isinstance(error, str) and error.strip():
        detail.append(error.replace("_", " "))
    else:
        plan = str(row.get("plan") or "").strip()
        if plan:
            detail.append(plan)
        account = str(row.get("account") or "").strip()
        if account:
            detail.append(account[:8])
        label = re.sub(r"\s+limit$", "", str(row.get("label") or "").strip(), flags=re.IGNORECASE)
        if label:
            detail.append(label)
        remaining = _token_plan_number(row.get("credits_remaining"))
        total = _token_plan_number(row.get("credits_total"))
        if remaining is not None and total is not None:
            detail.append(f"{_credits_label(remaining)} of {_credits_label(total)} left")
        tokens_left = _token_plan_number(row.get("tokens_remaining"))
        tokens_total = _token_plan_number(row.get("tokens_total"))
        if tokens_left is not None and tokens_total is not None:
            detail.append(f"{_tokens_label(tokens_left)} of {_tokens_label(tokens_total)} tokens left")
        balance = _token_plan_number(row.get("remaining_credits"))
        if balance is not None:
            detail.append(f"{_credits_label(balance)} credits left")
        if _token_plan_number(row.get("remaining_usd")) is not None:
            detail.append(f"${float(row['remaining_usd']):.2f} wallet")
    if detail:
        line += "  " + pango_escape(" · ".join(detail))
    tail = []
    reset = reset_phrase(row.get("resets_at"))
    if reset:
        tail.append(reset)
    age = _timestamp_age_sec(row.get("fetched_at"))
    if age is None:
        tail.append("fetch time unknown")
    elif age > STALE_AFTER_SEC:
        tail.append(f"fetched {age_text(age)}")
    if tail:
        line += "  " + muted(" · ".join(tail))
    return line


def coverage_line(snapshot: dict) -> str | None:
    """Credentials OMP could not meter, so a partial fleet never reads as
    whole. Silent when every credential reported."""
    bits = []
    without = snapshot.get("accounts_without_usage") or 0
    disabled = snapshot.get("disabled_credentials") or 0
    if without:
        bits.append(f"{without} account{'s' if without != 1 else ''} without usage data")
    if disabled:
        bits.append(f"{disabled} credential{'s' if disabled != 1 else ''} disabled")
    return muted(" · ".join(bits)) if bits else None


def _row_section(rows: list) -> list[str]:
    lines = [usage_row_line(index, item) for index, item in enumerate(rows, 1) if isinstance(item, dict)]
    return [""] + lines if lines else []


def _snapshot_section(rec: dict) -> list[str]:
    snapshot = rec.get("snapshot")
    line = coverage_line(snapshot) if isinstance(snapshot, dict) else None
    return [line] if line else []


def _anthropic_chip_pcts(rec: dict, rows: list[dict]) -> list[float | None]:
    """One reading per stored Claude credential, in OMP's report order.

    Each account reads the window that binds it (5-hour wall, weekly wall, or a
    model cap). A credential OMP listed without usage keeps an unknown slot, so
    an account never drops off the chip; no accounts at all reads as one dash.
    """
    snapshot = rec.get("snapshot") if isinstance(rec.get("snapshot"), dict) else {}
    unmetered = snapshot.get("accounts_without_usage")
    if not isinstance(unmetered, int) or isinstance(unmetered, bool) or unmetered < 0:
        unmetered = 0
    pcts = [as_pct(row.get("used_pct")) for row in rows] + [None] * unmetered
    return pcts or [None]


def cmd_waybar() -> int:
    cache = load_cache()
    pid = pick_selected(cache)
    rec = cache.get("providers", {}).get(pid)
    if not isinstance(rec, dict):
        rec = empty_provider(pid if pid in PROVIDER_INDEX else "codex", "unknown", "no_cache")
        rec["logo"] = PROVIDER_INDEX.get(pid, ("?", "?"))[1] if pid in PROVIDER_INDEX else "?"
    if pid == "cursor":
        rec = attach_cursor_identity(dict(rec))
    logo = str(rec.get("logo") or PROVIDER_INDEX.get(pid, ("?", "?"))[1])
    ident = rec.get("identity") if isinstance(rec.get("identity"), dict) else {}
    ident_id = str(ident.get("id") or ident.get("label") or "").strip()
    mark = f"{logo} {ident_id}" if ident_id else logo
    rows = [item for item in rec.get("account_usage") or [] if isinstance(item, dict)]
    if pid == "anthropic":
        # Each Claude account is its own meter: averaging an exhausted account
        # with an idle one would hide which credential still has headroom.
        pcts = _anthropic_chip_pcts(rec, rows)
        text = " ".join([pango_escape(mark), *(meter(pct) for pct in pcts)])
    elif pid == "mistral":
        # Month-to-date spend is the readout; a budget adds a meter before it.
        month = window_by_kind(rec, "monthly") or {}
        month_bits = month.get("extra") if isinstance(month.get("extra"), dict) else {}
        spent = _token_plan_number(month_bits.get("spent_usd"))
        pct = as_pct(month.get("used_pct"))
        bits = [meter(pct)] if pct is not None else []
        bits.append(_usd_label(float(spent)) if spent is not None else meter(None))
        text = " ".join([pango_escape(mark), *bits])
        pcts = [pct]
    elif pid == "amr":
        # One readout per signed-in account, in slot order: the window that
        # binds it, the wallet when no window meters, a dash when neither.
        bits = []
        for row in rows:
            pct = as_pct(row.get("used_pct"))
            if pct is not None:
                bits.append(meter(pct))
            elif _token_plan_number(row.get("remaining_usd")) is not None:
                usd = float(row["remaining_usd"])
                bits.append(f"${usd:.0f}" if usd >= 10 else f"${usd:.2f}")
            else:
                bits.append(meter(None))
        if not bits:
            bits = [meter(None)]
        text = " ".join([pango_escape(mark), *bits])
        pcts = [as_pct(row.get("used_pct")) for row in rows]
    else:
        weekly = window_by_kind(rec, "weekly") or window_by_kind(rec, "monthly") or {}
        extra = extra_window(rec)
        extra_bits = extra.get("extra") if isinstance(extra.get("extra"), dict) else {}
        if extra.get("kind") == "credits" and extra_bits.get("remaining_usd") is not None:
            usd = float(extra_bits["remaining_usd"])
            extra_txt = f"${usd:.0f}" if usd >= 10 else f"${usd:.2f}"
        else:
            extra_txt = meter(extra.get("used_pct"))
        text = f"{pango_escape(mark)} {meter(weekly.get('used_pct'))} {extra_txt}"
        pcts = [as_pct(weekly.get("used_pct")), as_pct(extra.get("used_pct"))]
    credits = rec.get("credits") if isinstance(rec.get("credits"), dict) else {}
    remaining = _token_plan_number(credits.get("remaining"))
    if remaining is not None:
        text += f" {pango_escape(_credits_label(remaining))}cr"
    tokens = rec.get("tokens") if isinstance(rec.get("tokens"), dict) else {}
    tokens_left = _token_plan_number(tokens.get("remaining"))
    tokens_total = _token_plan_number(tokens.get("total"))
    unmetered_keys = _token_plan_number(tokens.get("unmetered_keys")) or 0
    if tokens_left is not None:
        text += f" {pango_escape(_tokens_label(tokens_left))} left"
    elif unmetered_keys:
        text += f" {pango_escape(str(tokens.get('key_count')))} keys"
    status = rec.get("status") or "unknown"
    classes = [status]
    age = cache_age_sec(cache)
    if age is not None and age > STALE_AFTER_SEC:
        classes.append("stale")
    # An empty balance blocks the account even while its windows read idle.
    exhausted = any(_token_plan_number(row.get("remaining_credits")) == 0 for row in rows)
    known = [p for p in pcts if p is not None]
    if exhausted or (known and max(known) >= 95):
        classes.append("critical")
    elif known and max(known) >= 80:
        classes.append("warn")

    notes = []
    if report_count(rec) > 1:
        notes.append(f"{report_count(rec)} account reports")
    if ident_id:
        title = str(ident.get("title") or ident_id)
        notes.append(f"identity: {ident_id}" + (f" · {title}" if title and title != ident_id else ""))
    elif len(rows) == 1 and str(rows[0].get("account") or "").strip():
        notes.append(f"account: {str(rows[0]['account']).strip()[:8]}")
    lines = tooltip_header(rec, pid, notes)
    limits = [w for w in rec.get("windows") or [] if isinstance(w, dict)]
    burst = rec.get("burst")
    if isinstance(burst, dict) and "used_pct" in burst:
        limits.append(burst)
    if limits:
        lines.append("")
        lines.extend(window_lines(limits, report_count(rec)))
    if tokens_total is not None:
        if tokens_left is not None:
            lines.append(f"{_tokens_label(tokens_left)} of {_tokens_label(tokens_total)} tokens left")
            hint = "one-time grant · tokens OMP spent, not usage elsewhere"
        else:
            lines.append(f"{_tokens_label(tokens_total)} grant across {tokens.get('key_count')} keys")
            hint = f"{unmetered_keys} key(s) not in OMP; usage unknown"
        unattributed = _token_plan_number(tokens.get("unattributed"))
        if unattributed:
            hint += f" · {_tokens_label(unattributed)} without a key id"
        lines.append(muted(hint))
    # A single snapshot repeats the limits above; rows only earn space when
    # there are several to compare.
    if len(rows) > 1:
        lines.extend(_row_section(rows))
    spend_lines = mistral_spend_lines(rec)
    if spend_lines:
        lines.append("")
        lines.extend(pango_escape(line) for line in spend_lines[:-1])
        lines.append(muted(spend_lines[-1]))
    lines.extend(_snapshot_section(rec))
    if age is not None:
        lines.append(muted(f"updated {age_text(age)}"))
    payload = {
        "text": text,
        "tooltip": "\n".join(lines),
        "class": classes,
        "alt": pid,
    }
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")
    return 0


def cmd_cycle(direction: str) -> int:
    cache = load_cache()
    providers = cache.get("providers", {})
    present = [pid for pid in active_provider_ids() if _provider_usable(providers.get(pid))]
    if not present:
        print("no authed providers with usage in cache")
        return 1
    current = pick_selected(cache)
    if current not in present:
        nxt = present[0]
    else:
        idx = present.index(current)
        delta = -1 if direction == "prev" else 1
        nxt = present[(idx + delta) % len(present)]
    cache["selected"] = nxt
    write_selected(nxt)
    # Persist selection without bumping probe freshness.
    path = cache_path()
    if path.exists():
        atomic_write(path, json.dumps(cache, indent=2, ensure_ascii=False) + "\n")
    poke_waybar()
    print(nxt)
    return 0


def cmd_identity(direction: str) -> int:
    """Cycle identities for the selected provider via its local swap helper."""
    cache = load_cache()
    selected = pick_selected(cache)
    if selected == "kimi":
        rec = cache.get("providers", {}).get("kimi")
        rows = rec.get("account_usage") if isinstance(rec, dict) else None
        n = len(rows) if isinstance(rows, list) else 0
        print(f"kimi: {n or '?'} accounts balanced by omp auth-gateway (no manual cycle)")
        return 0
    print(f"{selected}: no identity cycle configured")
    return 0


def cmd_validate() -> int:
    path = cache_path()
    if not path.exists():
        print("INVALID: no cache")
        return 1
    mode = stat.S_IMODE(path.stat().st_mode)
    cache = load_cache()
    ok = True
    notes = [f"cache: {path}", f"mode: {mode:o}"]
    if mode != 0o600:
        ok = False
        notes.append("mode must be 0600")
    if cache.get("version") != VERSION:
        ok = False
        notes.append(f"version {cache.get('version')} != {VERSION}")
    selected = pick_selected(cache)
    notes.append(f"selected: {selected}")
    providers = cache.get("providers") or {}
    if selected not in providers:
        ok = False
        notes.append("selected provider missing")
    for pid, rec in providers.items():
        if not isinstance(rec, dict):
            ok = False
            notes.append(f"{pid}: not an object")
            continue
        status = rec.get("status")
        if status not in ("ok", "unauth", "unknown"):
            ok = False
            notes.append(f"{pid}: bad status {status!r}")
        kinds = []
        for w in rec.get("windows") or []:
            if not isinstance(w, dict):
                ok = False
                continue
            kinds.append(w.get("kind"))
            if "used_pct" in w and as_pct(w.get("used_pct")) is None:
                ok = False
                notes.append(f"{pid}: invented/non-numeric used_pct")
        line = f"{pid}: {status}"
        if rec.get("reason"):
            line += f" {rec['reason']}"
        for w in rec.get("windows") or []:
            if isinstance(w, dict) and "used_pct" in w:
                line += f" {w.get('kind')}={w['used_pct']}"
        credits = rec.get("credits") if isinstance(rec.get("credits"), dict) else {}
        remaining = _token_plan_number(credits.get("remaining"))
        if remaining is not None:
            line += f" credits={_credits_label(remaining)}"
        notes.append(line)
    print("\n".join(notes))
    print("VALID" if ok else "INVALID")
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="ai-usage", description="AI CLI usage chip for Waybar")
    p.add_argument("--version", action="version", version=f"ai-usage {TOOL_VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)
    probe = sub.add_parser("probe", help="fetch provider windows into cache")
    probe.add_argument("id", nargs="?", help="provider id (default: active roster)")
    sub.add_parser("waybar", help="print Waybar JSON from cache only")
    cyc = sub.add_parser("cycle", help="rotate selected provider")
    cyc.add_argument("direction", nargs="?", default="next", choices=("next", "prev"))
    ident = sub.add_parser("identity", help="rotate identity inside the selected provider")
    ident.add_argument("direction", nargs="?", default="next", choices=("next", "prev"))
    sub.add_parser("validate", help="schema-check cache")
    sub.add_parser("refresh", help="probe the active roster")
    tui = sub.add_parser("tui", help="usage dashboard")
    tui.add_argument("--dump", action="store_true", help="print dashboard and exit")
    sel = sub.add_parser("select", help="set selected provider")
    sel.add_argument("id")
    login = sub.add_parser("login", help="sign in to a provider account")
    login.add_argument("id", choices=("amr",))
    return p


def main(argv: list[str] | None = None) -> int:
    ensure_path()
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:  # noqa: BLE001, S110 - best-effort encoding setup
        pass
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.cmd == "probe":
        ids = [args.id] if args.id else []
        return cmd_probe(ids)
    if args.cmd == "refresh":
        return cmd_probe([])
    if args.cmd == "waybar":
        return cmd_waybar()
    if args.cmd == "cycle":
        return cmd_cycle(args.direction)
    if args.cmd == "identity":
        return cmd_identity(args.direction)
    if args.cmd == "validate":
        return cmd_validate()
    if args.cmd == "tui":
        return cmd_tui(dump=args.dump)
    if args.cmd == "select":
        return cmd_select(args.id)
    if args.cmd == "login":
        return cmd_login(args.id)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
