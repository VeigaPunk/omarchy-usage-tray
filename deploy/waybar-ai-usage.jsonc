// Snippet only — deploy/install.sh writes absolute paths for your prefix.
"custom/ai-usage": {
    "exec": "ai-usage waybar",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "tooltip": true,
    "escape": false,
    "exec-on-event": false,
    "format": "{}",
    "on-scroll-up": "ai-usage cycle next; pkill -x -RTMIN+11 waybar",
    "on-scroll-down": "ai-usage cycle prev; pkill -x -RTMIN+11 waybar",
    "on-click": "ai-usage cycle next; pkill -x -RTMIN+11 waybar",
    "on-click-right": "ai-usage identity next; pkill -x -RTMIN+11 waybar",
    "on-click-right": "ai-usage identity next; pkill -x -RTMIN+11 waybar"
}
