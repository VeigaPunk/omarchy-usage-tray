// Snippet only — deploy/install.sh writes the installed symlink path
// (~/.local/bin/ai-usage) for every command below.
"custom/ai-usage": {
    "exec": "ai-usage waybar",
    "return-type": "json",
    "interval": 60,
    "signal": 11,
    "tooltip": true,
    "escape": false,
    "exec-on-event": false,
    "format": "{}",
    "on-scroll-up": "ai-usage cycle next",
    "on-scroll-down": "ai-usage cycle prev",
    "on-click": "ai-usage cycle next",
    "on-click-right": "ai-usage identity next"
}
